---
// Плавающая кнопка связи (FAB). Спецификация: docs/design-system-v2.md, п. 11.6.
// Приоритет каналов (Степан): звонок → МАКС → Telegram → WhatsApp.
// Клик по каналу = будущая цель Метрики (data-fab-goal).
const CHANNELS = [
  { goal: 'call', label: 'Позвонить', href: 'tel:+79287588483' },
  { goal: 'max', label: 'МАКС', href: 'https://max.ru/u/f9LHodD0cOKVRRd0t2pjN2pm8s7nWCNllQJYsSra5mx0QiqcfNxI553bSzc' },
  { goal: 'telegram', label: 'Telegram', href: 'https://t.me/xkalmar' },
  { goal: 'whatsapp', label: 'WhatsApp', href: 'https://wa.me/79287588483' },
];
---
<div class="contact-fab" id="contact-fab" style="display:none;">
  <nav class="contact-fab__menu" aria-label="Способы связи" style="display:none;">
    {CHANNELS.map((c) => (
      <a
        class={`contact-fab__item contact-fab__item--${c.goal}`}
        href={c.href}
        target={c.goal === 'call' ? undefined : '_blank'}
        rel={c.goal === 'call' ? undefined : 'noopener'}
        data-fab-goal={c.goal}
      >
        {c.label}
      </a>
    ))}
  </nav>
  <button
    type="button"
    class="contact-fab__toggle"
    id="contact-fab-toggle"
    aria-label="Связаться с нами"
    aria-expanded="false"
    aria-controls="contact-fab-menu"
  >
    <svg class="contact-fab__icon-chat" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
    </svg>
    <svg class="contact-fab__icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  </button>
</div>

<script>
  // @ts-nocheck
  const fab = document.getElementById('contact-fab');
  const toggle = document.getElementById('contact-fab-toggle');
  const menu = document.querySelector('.contact-fab__menu');

  // Показ после прокрутки первого экрана, чтобы не мешать hero.
  const SHOW_AFTER = 600;
  function onScroll() {
    const show = window.scrollY > SHOW_AFTER;
    fab.style.display = show ? 'block' : 'none';
    if (!show) closeMenu();
  }

  function closeMenu() {
    menu.style.display = 'none';
    toggle.setAttribute('aria-expanded', 'false');
    fab.classList.remove('is-open');
  }

  function openMenu() {
    menu.style.display = 'flex';
    toggle.setAttribute('aria-expanded', 'true');
    fab.classList.add('is-open');
  }

  toggle.addEventListener('click', () => {
    if (menu.style.display === 'flex') closeMenu();
    else openMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && fab.classList.contains('is-open')) closeMenu();
  });

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
.contact-fab {
  position: fixed;
  left: 16px;
  bottom: calc(16px + env(safe-area-inset-bottom));
  z-index: 90;
}
.contact-fab__toggle {
  width: 56px;
  height: 56px;
  border-radius: var(--radius-pill);
  border: 0;
  background: var(--cta);
  color: var(--on-cta);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--elev-2);
  transition: background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}
.contact-fab__toggle:hover { background: var(--cta-hover); }
.contact-fab__toggle:active { background: var(--cta-press); transform: scale(.96); }
.contact-fab__icon-chat, .contact-fab__icon-close { width: 24px; height: 24px; }
.contact-fab__icon-close { display: none; }
.contact-fab.is-open .contact-fab__icon-chat { display: none; }
.contact-fab.is-open .contact-fab__icon-close { display: block; }

.contact-fab__menu {
  position: absolute;
  left: 0;
  bottom: calc(100% + var(--space-3));
  flex-direction: column;
  gap: var(--space-2);
  min-width: 180px;
  background: var(--surface-raised);
  border: 1px solid var(--line);
  border-radius: var(--radius-m);
  padding: var(--space-2);
  box-shadow: var(--elev-3);
}
.contact-fab__item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 44px;
  padding: 0 var(--space-4);
  border-radius: var(--radius-s);
  color: var(--text);
  text-decoration: none;
  font-size: var(--font-body);
  font-weight: 600;
  transition: background var(--dur-fast) var(--ease);
}
.contact-fab__item:hover { background: rgba(255, 255, 255, 0.08); }
.contact-fab__item::before {
  content: '';
  width: 8px;
  height: 8px;
  border-radius: var(--radius-pill);
  background: var(--accent);
  flex: 0 0 8px;
}
.contact-fab__item--max::before { background: var(--chan-max); }
.contact-fab__item--telegram::before { background: var(--chan-tg); }
.contact-fab__item--whatsapp::before { background: var(--chan-wa); }
.contact-fab__item--call::before { background: var(--cta); }

/* На десктопе FAB не нужен (решение Степана): телефон в шапке, контакты в футере */
@media (min-width: 900px) {
  .contact-fab { display: none !important; }
}
</style>
