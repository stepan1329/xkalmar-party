<section class="drc" id="calc">
  <div class="drc__head">
    <h2>Рассчитайте праздник</h2>
    <p>Выберите готовый пакет или соберите свой формат. Цена видна сразу, итог пересчитывается мгновенно.</p>
  </div>

  <div class="drc__cards">
    <label class="drc-card">
      <input type="radio" name="dr-pack" value="popular">
      <span class="drc-card__in">
        <span class="drc-card__name">Популярный</span>
        <span class="drc-card__price">24 000 ₽</span>
        <span class="drc-card__meta"><b>2,5 часа</b> программы · до 15 детей · своя еда</span>
        <span class="drc-card__list">Квест-шоу 1,5 ч · Ярмарка игр 30 мин · банкет 30 мин · команда из 5 человек</span>
      </span>
    </label>
    <label class="drc-card">
      <input type="radio" name="dr-pack" value="optimal">
      <span class="drc-card__in">
        <span class="drc-card__badge">Выбирают чаще всего</span>
        <span class="drc-card__name">Оптимальный</span>
        <span class="drc-card__price">33 500 ₽</span>
        <span class="drc-card__meta"><b>3 часа</b> программы · до 6 детей еда включена</span>
        <span class="drc-card__list">Квест-шоу полного сценария 1,5 ч · Ярмарка игр 1 ч · банкет под ключ: сервировка, еда, напитки, порционный торт</span>
      </span>
    </label>
    <label class="drc-card">
      <input type="radio" name="dr-pack" value="maximal">
      <span class="drc-card__in">
        <span class="drc-card__name">Максимальный</span>
        <span class="drc-card__price">50 000 ₽</span>
        <span class="drc-card__meta"><b>3,5 часа</b> программы · всё включено</span>
        <span class="drc-card__list">Расширенный сценарий · Ярмарка игр 1 ч · банкет под ключ + большой торт от кондитера · фото · гелиевые шары · подарки всем</span>
      </span>
    </label>
  </div>

  <div class="drc__custom">
    <span class="drc__custom-title">Или соберите свой формат</span>
    <div class="drc__custom-body">
      <span class="drc-lbl">Основа</span>
      <div class="drc-radios">
        <label><input type="radio" name="dr-cbase" value="base"><span><b>База — 20 000 ₽</b> · квест-шоу 1,5 ч + банкет 30 мин (2 ч программы) · до 15 детей</span></label>
        <label><input type="radio" name="dr-cbase" value="mini"><span><b>Мини — 15 000 ₽</b> · квест 1 ч + банкет 30 мин (1,5 часа программы) · до 8 детей</span></label>
      </div>
      <span class="drc-lbl">Ярмарка игр</span>
      <div class="drc-radios" id="dr-cym-group">
        <label><input type="radio" name="dr-cym" value="0"><span><b>Без ярмарки</b> · только квест и банкет</span></label>
        <label><input type="radio" name="dr-cym" value="30"><span><b>+30 мин — 4 000 ₽</b> · короткая добавка к программе</span></label>
        <label><input type="radio" name="dr-cym" value="60"><span><b>+60 мин — 7 500 ₽</b> · самый насыщенный вариант</span></label>
      </div>
      <button type="button" class="drc-preset" id="dr-preset">Собрать как «Расширенный»: База + Ярмарка 1 ч + еда под ключ + фото + шары</button>
    </div>
  </div>

  <div class="drc__cols">
    <div class="drc__steps" id="dr-steps" hidden>
      <div class="drc-step">
        <button type="button" class="drc-step__head is-open" data-stephead="0" aria-expanded="true">
          <span class="drc-step__title">Сколько детей</span>
          <span class="drc-step__chev">▾</span>
        </button>
        <div class="drc-step__body" data-stepbody="0">
          <div class="drc-stepper">
            <button type="button" id="dr-minus">−</button>
            <output id="dr-guests">6</output>
            <button type="button" id="dr-plus">+</button>
          </div>
          <span class="drc-gnote" id="dr-gnote"></span>
          <span class="drc-hint">Не знаешь точного числа? Поставь примерно — потом можно изменить.</span>
        </div>
      </div>

      <div class="drc-step">
        <button type="button" class="drc-step__head" data-stephead="1" aria-expanded="false">
          <span class="drc-step__title">Дата и время начала</span>
          <span class="drc-step__chev">▾</span>
        </button>
        <div class="drc-step__body" data-stepbody="1" hidden>
          <input type="date" id="dr-date" class="drc-date">
          <div class="drc-slots" id="dr-slots"></div>
          <span class="drc-hint">Время начала можно выбрать сейчас или оставить организатору.</span>
        </div>
      </div>

      <div class="drc-step">
        <button type="button" class="drc-step__head" data-stephead="2" aria-expanded="false">
          <span class="drc-step__title">Продление праздника</span>
          <span class="drc-step__chev">▾</span>
        </button>
        <div class="drc-step__body" data-stepbody="2" hidden>
          <div class="drc-ext" id="dr-ext-block"></div>
          <div class="drc-ext">
            <label class="drc-opt"><input type="checkbox" id="dr-room-ext"><span class="drc-opt__b"><b>Продление банкетной комнаты</b><span>комната остаётся за вами, программа не ведётся</span></span></label>
            <div class="drc-hours" id="dr-room-hours" hidden>
              <label><input type="radio" name="dr-rh" value="30" checked>+30 мин · 1 250 ₽</label>
              <label><input type="radio" name="dr-rh" value="60">+60 мин · 2 500 ₽</label>
            </div>
          </div>
        </div>
      </div>

      <div class="drc-step">
        <button type="button" class="drc-step__head" data-stephead="3" aria-expanded="false">
          <span class="drc-step__title">Дополнительные услуги</span>
          <span class="drc-step__chev">▾</span>
        </button>
        <div class="drc-step__body" data-stepbody="3" hidden>
          <div class="drc-ext">
            <label class="drc-opt" id="dr-opt-menu"><input type="checkbox" id="dr-menu"><span class="drc-opt__b"><b>Меню под ключ</b><span>сервировка, еда, напитки, порционный торт</span></span><span class="drc-opt__p">1 000 ₽ / чел</span></label>
            <label class="drc-opt" id="dr-opt-video"><input type="checkbox" id="dr-video"><span class="drc-opt__b"><b>Видеосъёмка</b><span>сторис-ролик 1–3 минуты</span></span><span class="drc-opt__p">4 000 ₽</span></label>
            <label class="drc-opt" id="dr-opt-photo"><input type="checkbox" id="dr-photo"><span class="drc-opt__b"><b>Фотосъёмка</b><span>100–150 готовых фото</span></span><span class="drc-opt__p">6 000 ₽</span></label>
            <label class="drc-opt" id="dr-opt-balls"><input type="checkbox" id="dr-balls"><span class="drc-opt__b"><b>Гелиевые шары</b><span>две сборки, 14 шаров</span></span><span class="drc-opt__p">3 500 ₽</span></label>
            <label class="drc-opt" id="dr-opt-tort"><input type="checkbox" id="dr-tort"><span class="drc-opt__b"><b>Тематический торт</b><span>2–2,5 кг, вместо порционного — вычет</span></span><span class="drc-opt__p">7 000 ₽</span></label>
            <label class="drc-opt drc-opt--free" id="dr-opt-room2"><input type="checkbox" id="dr-room2"><span class="drc-opt__b"><b>Вторая банкетная комната</b><span>по запросу</span></span><span class="drc-opt__p">0 ₽</span></label>
          </div>
        </div>
      </div>
    </div>

    <div class="drc-plate" id="dr-result" hidden>
      <div class="drc-plate__head">
        <div>
          <span class="drc-plate__tag">Ваш тариф</span>
          <b class="drc-plate__price" id="dr-total">0 ₽</b>
        </div>
        <div class="drc-plate__btns">
          <button type="button" class="drc-btn drc-btn--ghost" id="dr-choose">Выбрать</button>
          <button type="button" class="drc-btn" id="dr-book">Забронировать</button>
        </div>
      </div>
      <div class="drc-plate__cats" id="dr-breakdown"></div>
      <div class="drc-plate__meta" id="dr-duration"></div>
      <div class="drc-plate__actions">
        <button type="button" class="drc-btn drc-btn--ghost" id="dr-help">Помочь с расчётом</button>
        <button type="button" class="drc-btn drc-btn--ghost" id="dr-reset">Сбросить выбор</button>
      </div>
      <p class="drc-plate__note">Заявка ни к чему не обязывает. Организатор подтвердит свободное время и точную сумму. Бронь фиксируется предоплатой 3 000 ₽.</p>
    </div>
  </div>

  <p class="drc-foot">Расчёт предварительный: точную сумму и свободное время подтверждает организатор.</p>
</section>

<div class="drc-bar" id="dr-bar" hidden>
  <div class="drc-bar__top">
    <div class="drc-bar__sum">
      <b id="dr-bar-total">0 ₽</b><span>предварительно</span>
      <span class="drc-bar__hint" id="dr-bar-hint"></span>
    </div>
    <div class="drc-bar__tools">
      <button type="button" class="drc-bar__reset" id="dr-bar-reset" aria-label="Сбросить выбор" title="Сбросить выбор">↺</button>
      <button type="button" class="drc-bar__x" id="dr-bar-close" aria-label="Скрыть корзину">✕</button>
    </div>
  </div>
  <div class="drc-bar__btns">
    <button type="button" class="drc-btn drc-btn--bar-ghost" id="dr-bar-choose">Перенести</button>
    <button type="button" class="drc-btn drc-btn--bar" id="dr-bar-book">Забронировать</button>
  </div>
</div>

<button type="button" class="drc-pill" id="dr-pill" hidden aria-label="Открыть корзину">
  <b id="dr-pill-total">0 ₽</b>
  <span class="drc-pill__dot" aria-hidden="true"></span>
</button>

<div class="drc-toast" id="dr-toast" hidden>
  <span>Состав перенесён в заявку</span>
  <button type="button" class="is-ghost" id="dr-toast-go">Перейти к заявке</button>
  <button type="button" class="is-plain" id="dr-toast-stay">Продолжить</button>
</div>

<div class="drc-toast drc-toast--mini" id="dr-toast-mini" hidden>
  <span id="dr-toast-mini-text"></span>
</div>

<div class="drc-modal" id="dr-modal" hidden>
  <div class="drc-modal__box">
    <button type="button" class="drc-modal__x" id="dr-modal-x">✕</button>
    <b class="drc-modal__title" id="dr-modal-title">Связаться с организатором</b>
    <p class="drc-modal__sub">Выберите удобный мессенджер — текст заявки уже подготовлен.</p>
    <div class="drc-modal__btns">
      <a class="drc-chan drc-chan--wa" id="dr-chan-wa" target="_blank" rel="noopener">WhatsApp</a>
      <a class="drc-chan drc-chan--tg" id="dr-chan-tg" target="_blank" rel="noopener">Telegram</a>
      <a class="drc-chan drc-chan--max" id="dr-chan-max" target="_blank" rel="noopener">MAX</a>
      <a class="drc-chan drc-chan--tel" id="dr-chan-tel">Позвонить</a>
    </div>
  </div>
</div>

<style is:global>
[hidden] { display: none !important; }
.drc { background: #032E2B; color: #fff; padding: 72px 20px 80px; overflow-x: hidden; }
.drc * { box-sizing: border-box; }
.drc h2 { font-size: clamp(24px, 4vw, 34px); font-weight: 700; text-align: center; margin: 0 0 12px; }
.drc__head p { max-width: 640px; margin: 0 auto 28px; text-align: center; color: rgba(255,255,255,.75); font-size: 15px; line-height: 1.6; }

.drc__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; max-width: 1080px; margin: 0 auto; }
.drc-card { position: relative; display: block; cursor: pointer; }
.drc-card input { position: absolute; opacity: 0; pointer-events: none; }
.drc-card__in { display: flex; flex-direction: column; gap: 6px; height: 100%; background: #fff; color: #032E2B; border: 2px solid transparent; border-radius: 20px; padding: 22px 20px; transition: .2s; }
.drc-card:hover .drc-card__in { border-color: rgba(10,153,148,.5); transform: translateY(-2px); }
.drc-card input:checked ~ .drc-card__in { border-color: #C30067; box-shadow: 0 10px 30px rgba(195,0,103,.25); }
.drc-card__name { font-size: 18px; font-weight: 700; }
.drc-card__price { font-size: 26px; font-weight: 800; color: #C30067; }
.drc-card__meta { font-size: 13px; color: #3C5B57; }
.drc-card__meta b { color: #0A9994; font-weight: 700; }
.drc-card__list { font-size: 12.5px; line-height: 1.6; color: #3C5B57; margin-top: 6px; }
.drc-card__badge {
  position: absolute; top: 12px; right: 12px;
  background: #C30067; color: #fff;
  font-size: 11px; font-weight: 600;
  padding: 4px 10px; border-radius: 12px;
  z-index: 1; white-space: nowrap; line-height: 1.3;
}

.drc__custom { max-width: 1080px; margin: 18px auto 0; }
.drc__custom-title { display: block; text-align: center; font-size: 13px; font-weight: 600; color: rgba(255,255,255,.55); margin-bottom: 12px; letter-spacing: .02em; }
.drc__custom-body { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.12); border-radius: 16px; padding: 22px 24px; }

.drc-lbl { display: block; font-size: 12px; font-weight: 600; letter-spacing: .04em; color: rgba(255,255,255,.7); margin: 0 0 10px; }
.drc-radios { display: grid; gap: 8px; margin: 0 0 18px; }
.drc-radios label { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-start; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.18); border-radius: 12px; padding: 12px 14px; cursor: pointer; font-size: 14px; line-height: 1.5; }
.drc-radios label b { display: block; }
.drc-radios label:has(input:checked) { border-color: #C30067; }
.drc-radios input { accent-color: #C30067; margin: 3px 0 0; }
.drc-preset { width: 100%; display: block; font: inherit; font-size: 13px; font-weight: 600; color: #0AD9C6; background: rgba(10,153,148,.12); border: 1px dashed rgba(10,217,198,.5); padding: 12px 14px; border-radius: 12px; cursor: pointer; }
.drc-preset:hover { border-color: #C30067; color: #C30067; }

.drc__cols { max-width: 1080px; margin: 32px auto 0; display: grid; gap: 24px; align-items: start; }
@media (min-width: 901px) {
  .drc__cols { grid-template-columns: minmax(0, 1fr) 420px; }
  .drc-plate { position: sticky; top: 20px; }
}

.drc__steps { background: #fff; color: #032E2B; border-radius: 20px; padding: 20px 28px; display: grid; gap: 0; }
.drc-stepper { display: inline-flex; align-items: center; gap: 14px; background: #F5F7F6; border-radius: 12px; padding: 8px 12px; }
.drc-stepper button { width: 32px; height: 32px; border: 0; border-radius: 10px; background: #05544F; color: #fff; font-size: 16px; font-weight: 800; cursor: pointer; }
.drc-stepper button:disabled { opacity: .35; cursor: default; }
.drc-stepper output { min-width: 48px; text-align: center; font-size: 16px; font-weight: 800; }
.drc-gnote { display: block; margin-top: 8px; font-size: 12px; color: #3C5B57; }
.drc-hint { display: block; margin-top: 10px; font-size: 12px; line-height: 1.5; color: #6B8B86; }
.drc-date { font: inherit; font-size: 15px; padding: 10px 14px; border: 1px solid #E4ECEA; border-radius: 12px; color: #032E2B; background: #fff; width: 100%; max-width: 240px; }
.drc-slots { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.drc-slot { font: inherit; font-size: 13px; padding: 8px 16px; border: 1px solid #E4ECEA; border-radius: 10px; background: #fff; color: #3C5B57; cursor: pointer; }
.drc-slot.is-active { border-color: #C30067; color: #C30067; font-weight: 700; }

.drc-ext { display: grid; gap: 10px; }
.drc-opt { display: flex; gap: 12px; align-items: flex-start; border: 1px solid #E4ECEA; border-radius: 12px; padding: 12px 14px; cursor: pointer; transition: .15s; }
.drc-opt:hover { border-color: rgba(10,153,148,.5); }
.drc-opt:has(input:checked) { border-color: #C30067; }
.drc-opt.is-incl { border-style: dashed; }
.drc-opt.is-incl .drc-opt__p { color: #0A9994; }
.drc-opt input { width: 18px; height: 18px; margin: 2px 0 0; accent-color: #C30067; flex: 0 0 auto; }
.drc-opt input:disabled { opacity: .6; }
.drc-opt__b { flex: 1; min-width: 0; }
.drc-opt__b b { display: block; font-size: 13.5px; font-weight: 700; color: #032E2B; }
.drc-opt__b span { font-size: 12px; color: #3C5B57; }
.drc-opt__p { font-size: 13.5px; font-weight: 700; color: #032E2B; white-space: nowrap; }
.drc-opt--free .drc-opt__p { color: #0A9994; }
.drc-hours { display: flex; gap: 8px; padding-left: 30px; flex-wrap: wrap; }
.drc-hours label { font-size: 13px; color: #3C5B57; cursor: pointer; border: 1px solid #E4ECEA; border-radius: 10px; padding: 6px 14px; }
.drc-hours label:has(input:checked) { border-color: #C30067; color: #C30067; font-weight: 700; }
.drc-hours input { display: none; }

.drc-plate { background: #fff; color: #032E2B; border-radius: 22px; padding: 22px 26px; box-shadow: 0 16px 48px rgba(0,0,0,.35); max-width: 100%; overflow: hidden; }
.drc-plate__head { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding-bottom: 14px; border-bottom: 2px solid #E4ECEA; }
.drc-plate__tag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .04em; color: #C30067; margin-bottom: 4px; }
.drc-plate__price { display: block; font-size: clamp(30px, 8vw, 40px); font-weight: 800; line-height: 1.1; }
.drc-btn { font: inherit; font-weight: 700; font-size: 14px; padding: 13px 28px; border-radius: 30px; border: 0; background: #C30067; color: #fff; cursor: pointer; transition: .2s; }
.drc-btn:hover { background: #E00077; transform: translateY(-2px); }
.drc-btn--ghost { background: transparent; color: #05544F; border: 2px solid #05544F; padding: 11px 24px; }
.drc-btn--ghost:hover { background: #F5F7F6; transform: none; }
.drc-btn.is-picked { background: transparent; color: #0A9994; border: 2px solid #0A9994; padding: 11px 24px; }
.drc-btn.is-picked:hover { background: rgba(10,153,148,.06); transform: none; }

.drc-plate__cats { margin-top: 4px; }
.drc-catbtn { width: 100%; font: inherit; text-align: left; background: none; border: 0; border-bottom: 1px dashed #E4ECEA; padding: 12px 0; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 10px; }
.drc-catbtn .l { display: grid; gap: 2px; min-width: 0; flex: 1 1 auto; }
.drc-catbtn .lbl { font-size: 11px; font-weight: 600; color: #6B8B86; }
.drc-catbtn .t { font-size: 14px; font-weight: 600; color: #032E2B; overflow-wrap: anywhere; }
.drc-catbtn .r { display: flex; align-items: center; gap: 8px; flex: 0 0 auto; }
.drc-catbtn .v { font-size: 14px; font-weight: 700; color: #032E2B; white-space: nowrap; }
.drc-catbtn .v.is-money { color: #C30067; }
.drc-catbtn .v.is-none { color: #6B8B86; font-weight: 400; }
.drc-catbtn .chev { font-size: 13px; font-weight: 700; color: #C30067; transition: transform .2s; }
.drc-catbtn.is-open .chev { transform: rotate(180deg); }
.drc-catsub { display: none; padding: 6px 0 8px; border-bottom: 1px dashed #E4ECEA; }
.drc-catsub.is-open { display: grid; gap: 4px; }
.drc-catrow { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: baseline; font-size: 13px; line-height: 1.5; color: #032E2B; padding: 5px 0; border-bottom: 1px solid rgba(228,236,234,.5); }
.drc-catrow:last-child { border-bottom: 0; }
.drc-catrow span { overflow-wrap: anywhere; word-break: break-word; }
.drc-catrow b { font-weight: 500; color: #3C5B57; white-space: nowrap; }
.drc-catrow.is-muted { color: #6B8B86; }
.drc-catrow.is-muted b { color: #6B8B86; font-weight: 400; }

.drc-plate__meta { margin-top: 14px; font-size: 13px; font-weight: 600; color: #3C5B57; background: #F5F7F6; border-radius: 10px; padding: 10px 14px; }
.drc-plate__actions { margin-top: 16px; display: flex; gap: 10px; flex-wrap: wrap; }
.drc-plate__note { margin: 16px 0 0; font-size: 12px; line-height: 1.6; color: #6B8B86; }
.drc-foot { margin-top: 18px; text-align: center; font-size: 12px; color: rgba(255,255,255,.5); }

.drc-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; display: flex; flex-direction: column; gap: 8px; background: #021F1D; padding: 12px 14px calc(12px + env(safe-area-inset-bottom)); box-shadow: 0 -6px 24px rgba(0,0,0,.4); }
.drc-bar__top { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
.drc-bar__sum { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 8px; }
.drc-bar__sum b { font-size: 20px; font-weight: 800; line-height: 1.15; }
.drc-bar__sum > span { font-size: 12px; color: rgba(255,255,255,.55); }
.drc-bar__hint { flex-basis: 100%; font-size: 12px; color: #0AD9C6; font-weight: 600; }
.drc-bar__tools { display: flex; gap: 8px; }
.drc-bar__reset { width: 38px; height: 38px; border: 0; border-radius: 50%; background: rgba(255,255,255,.12); color: rgba(255,255,255,.7); font-size: 16px; cursor: pointer; }
.drc-bar__x { width: 38px; height: 38px; border: 0; border-radius: 50%; background: rgba(255,255,255,.12); color: rgba(255,255,255,.7); font-size: 15px; cursor: pointer; }
.drc-bar__btns { display: flex; gap: 8px; }
.drc-btn--bar { flex: 1.3 1 0; padding: 14px 10px; border-radius: 20px; font-size: 14px; }
.drc-btn--bar-ghost { flex: 1 1 0; background: transparent; color: #fff; border: 2px solid rgba(255,255,255,.45); padding: 12px 10px; border-radius: 20px; font-size: 14px; }
.drc-btn--bar-ghost.is-picked { color: #0AD9C6; border-color: rgba(10,217,198,.6); }

.drc-pill { position: fixed; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); z-index: 49; display: inline-flex; align-items: center; gap: 8px; height: 48px; padding: 0 18px; border: 0; border-radius: 24px; background: #C30067; color: #fff; box-shadow: 0 8px 24px rgba(0,0,0,.45); cursor: pointer; font: inherit; }
.drc-pill:hover { background: #E00077; }
.drc-pill b { font-size: 16px; font-weight: 800; line-height: 1; }
.drc-pill__dot { display: none; width: 8px; height: 8px; border-radius: 50%; background: #0AD9C6; }
.drc-pill.is-dirty .drc-pill__dot { display: inline-block; }

.drc-toast { position: fixed; left: 50%; transform: translateX(-50%); width: calc(100% - 32px); max-width: 400px; bottom: 28px; z-index: 60; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; background: #fff; color: #032E2B; border-radius: 16px; padding: 14px 16px; box-shadow: 0 16px 48px rgba(0,0,0,.55), 0 0 0 1px rgba(0,0,0,.06); font-size: 14px; font-weight: 600; }
.drc-toast > span:first-child { flex: 1 1 100%; margin-bottom: 2px; }
.drc-toast button { font: inherit; font-size: 13px; font-weight: 700; padding: 9px 14px; border-radius: 20px; cursor: pointer; flex: 1 1 auto; }
.drc-toast button.is-ghost { background: transparent; color: #C30067; border: 2px solid #C30067; }
.drc-toast button.is-plain { background: transparent; color: #6B8B86; border: 1px solid #E4ECEA; }
.drc-toast--mini { max-width: 340px; bottom: 96px; font-weight: 500; }

@media (min-width: 761px) { .drc-pill { display: none; } }
.drc-modal { position: fixed; inset: 0; z-index: 100; background: rgba(1,16,15,.7); display: flex; align-items: center; justify-content: center; padding: 20px; }
.drc-modal__box { position: relative; background: #fff; color: #032E2B; border-radius: 22px; padding: 30px 30px 24px; max-width: 420px; width: 100%; }
.drc-modal__x { position: absolute; top: 14px; right: 14px; width: 34px; height: 34px; border: 0; border-radius: 50%; background: #F5F7F6; color: #3C5B57; font-size: 14px; cursor: pointer; }
.drc-modal__title { display: block; font-size: 19px; font-weight: 700; margin-bottom: 8px; }
.drc-modal__sub { margin: 0 0 18px; font-size: 13px; line-height: 1.6; color: #3C5B57; }
.drc-modal__btns { display: grid; gap: 10px; }
.drc-chan { display: block; text-align: center; font: inherit; font-weight: 700; font-size: 15px; padding: 14px; border-radius: 14px; color: #fff; text-decoration: none; }
.drc-chan--wa { background: #128C7E; }
.drc-chan--tg { background: #2AABEE; }
.drc-chan--max { background: #6A3CF5; }
.drc-chan--tel { background: #032E2B; }

.drc-step { border-bottom: 1px dashed #E4ECEA; }
.drc-step:last-child { border-bottom: 0; }
.drc-step__head { display: flex; align-items: center; justify-content: space-between; width: 100%; font: inherit; background: none; border: 0; text-align: left; padding: 14px 0; cursor: pointer; gap: 12px; }
.drc-step__title { font-size: 15px; font-weight: 600; color: #032E2B; }
.drc-step__chev { font-size: 13px; font-weight: 600; color: #6B8B86; transition: transform .2s; flex: 0 0 auto; }
.drc-step__head.is-open .drc-step__chev { transform: rotate(180deg); color: #C30067; }
.drc-step__body { padding-bottom: 14px; }

@media (max-width: 900px) { .drc__cards { grid-template-columns: 1fr; } }
@media (max-width: 760px) {
  .drc { padding: 48px 14px 150px; }
  .drc__steps, .drc-plate { padding: 18px 16px; }
  .drc-plate__head { flex-direction: column; align-items: stretch; }
  .drc-plate .drc-btn { width: 100%; }
  .drc-toast { bottom: 126px; }
}
@media (min-width: 761px) { .drc-bar { display: none; } }
</style>

<script is:inline>
// Калькулятор v9.0 — модель «pill = корзина», единый флоу без вкладок
// @ts-nocheck
  const CONFIG = {
    wa: '79287588483',
    tg: 'xkalmar',
    max: 'https://max.ru/u/f9LHodD0cOKVRRd0t2pjN2pm8s7nWCNllQJYsSra5mx0QiqcfNxI553bSzc',
    tel: '+79287588483',
    startHour: 10,
    endHour: 22
  };
  const MAX_GUESTS = 20;
  const LS_KEY = 'xkalmar-calc-v1';

  const TARIFFS = {
    popular:  { name: 'Популярный',  price: 24000, freeGuests: 15, minGuests: 5, program: 2.5, food: false, inclYm: 30,
                includes: [ 'Квест-шоу 1,5 ч', 'Ярмарка игр 30 мин', 'Банкет 30 мин', 'Команда из 5 человек' ],
                ext: [ { v: 0, label: '30 мин — как в пакете', p: 0 }, { v: 30, label: '+30 мин — доплата 3 500 ₽', p: 3500 } ] },
    optimal:  { name: 'Оптимальный', price: 33500, freeGuests: 6,  minGuests: 6, program: 3, food: true, inclYm: 60,
                includes: [ 'Квест-шоу полного сценария 1,5 ч', 'Ярмарка игр 1 ч', 'Банкет под ключ' ],
                ext: [ { v: 0, label: '1 ч — входит в пакет', p: 0 } ] },
    maximal:  { name: 'Максимальный', price: 50000, freeGuests: 6, minGuests: 6, program: 3.5, food: true, inclYm: 60,
                includes: [ 'Расширенный сценарий', 'Ярмарка игр 1 ч', 'Банкет под ключ', 'Торт от кондитера', 'Фото', 'Шары', 'Подарки' ],
                ext: [ { v: 0, label: '1 ч — входит в пакет', p: 0 } ] },
    base:     { name: 'База', price: 20000, freeGuests: 15, minGuests: 5, program: 2, food: false, inclYm: 0,
                includes: [ 'Квест-шоу 1,5 ч', 'Банкет 30 мин' ],
                ext: [ { v: 0, label: 'Без ярмарки', p: 0 } ] },
    mini:     { name: 'Мини', price: 15000, freeGuests: 8, minGuests: 5, program: 1.5, food: false, inclYm: 0,
                includes: [ 'Квест 1 ч', 'Банкет 30 мин' ],
                ext: [ { v: 0, label: 'Без ярмарки', p: 0 } ] }
  };

  const state = {
    mode: 'packs',        // 'packs' | 'custom'
    pack: null,           // popular|optimal|maximal
    customBase: 'base',
    customYm: '0',
    guests: 6, slot: null, guestsTouched: false
  };
  let lastTotal = 0;
  let lastOrder = null;
  let snapshot = null;
  let dirty = false;
  let barClosed = true;   // стартуем с закрытым баром
  let toastTimer = null;
  let miniToastTimer = null;
  const plateOpen = { pack: false, party: false, extras: false };

  window.DR_CALC = {
    ready: false, selected: false, tariff: '', guests: 0,
    date: '', slot: '', extras: '', total: 0, summary: '', order: null,
    dirty: false, justUpdatedAt: 0
  };

  const $ = (id) => document.getElementById(id);
  const fmt = (n) => n.toLocaleString('ru-RU') + ' ₽';
  const fmtH = (h) => String(h).replace('.', ',') + ' ч';

  function plural(n, one, few, many) {
    const m10 = n % 10, m100 = n % 100;
    if (m10 === 1 && m100 !== 11) return one;
    if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
    return many;
  }

  function currentTariff() {
    return state.mode === 'packs' ? TARIFFS[state.pack] : TARIFFS[state.customBase];
  }
  function currentExt() {
    const sel = document.querySelector('input[name="dr-ext"]:checked');
    return sel ? parseInt(sel.value, 10) : 0;
  }
  function customYm() { return parseInt(state.customYm, 10) || 0; }
  function roomExtMinutes() {
    if (!$('dr-room-ext').checked) return 0;
    const sel = document.querySelector('input[name="dr-rh"]:checked');
    return sel ? parseInt(sel.value, 10) : 30;
  }
  function programHours() {
    const t = currentTariff();
    if (!t) return 0;
    return t.program + (state.mode === 'packs' ? currentExt() : customYm()) / 60;
  }
  function slotHours() { return programHours() + 0.5 + roomExtMinutes() / 60; }
  function ymAddPrice() {
    const t = currentTariff();
    if (state.mode === 'packs') {
      const v = currentExt();
      return (t.ext.find((e) => e.v === v) || { p: 0 }).p;
    }
    const m = customYm();
    return m === 30 ? 4000 : m === 60 ? 7500 : 0;
  }
  function setDisplay(id, show) { $(id).style.display = show ? '' : 'none'; }
  function isIncluded(optId) {
    return state.mode === 'packs' && state.pack === 'maximal' && ['dr-video','dr-photo','dr-balls','dr-tort'].includes(optId);
  }
  function resetExtras() {
    ['dr-menu','dr-video','dr-photo','dr-balls','dr-tort','dr-room2','dr-room-ext'].forEach((id) => { $(id).checked = false; });
    $('dr-room-hours').hidden = true;
  }

  function hasChangesSinceSnapshot() {
    if (!snapshot || !lastOrder) return false;
    if (snapshot.tariffKey !== lastOrder.tariffKey) return true;
    if (snapshot.guests !== lastOrder.guests) return true;
    if (snapshot.dateISO !== lastOrder.dateISO) return true;
    if (snapshot.slot !== lastOrder.slot) return true;
    if ((snapshot.extras || []).join('|') !== (lastOrder.extras || []).join('|')) return true;
    return false;
  }

  /* Кнопка-команда: 3 состояния */
  function syncChooseBtns() {
    const plate = $('dr-choose');
    const bar = $('dr-bar-choose');
    if (!plate) return;

    plate.classList.remove('is-picked');
    bar.classList.remove('is-picked');

    if (!snapshot) { plate.textContent = 'Выбрать'; bar.textContent = 'В корзине'; }
    else if (dirty) { plate.textContent = 'Перенести в заявку'; bar.textContent = 'Перенести'; }
    else { plate.textContent = '✓ Выбрано'; plate.classList.add('is-picked'); bar.textContent = '✓ В заявке'; bar.classList.add('is-picked'); }
  }

  /* Pill = корзина. Скрыт, когда snapshot актуален. Показан, когда есть черновик, но нет в заявке */
  function showCart() {
    const hasCart = !!(state.mode === 'packs' ? state.pack : true);
    const active = hasCart && (snapshot === null || dirty);

    if (!active) {
      $('dr-bar').hidden = true;
      $('dr-pill').hidden = true;
      return;
    }
    $('dr-pill-total').textContent = fmt(lastTotal);
    $('dr-pill').classList.toggle('is-dirty', dirty);

    if (barClosed) {
      $('dr-bar').hidden = true;
      $('dr-pill').hidden = false;
    } else {
      $('dr-bar').hidden = false;
      $('dr-pill').hidden = true;
    }
  }

  function syncBarHint() {
    const hint = $('dr-bar-hint');
    if (!hint) return;
    const extras = collectExtras();
    const cnt = extras.length;
    if (dirty && snapshot) {
      hint.textContent = 'В корзине изменения' + (cnt ? ' · ' + cnt + ' ' + plural(cnt, 'услуга', 'услуги', 'услуг') : '');
    } else if (!snapshot) {
      hint.textContent = 'Корзина' + (cnt ? ' · ' + cnt + ' ' + plural(cnt, 'услуга', 'услуги', 'услуг') : '');
    } else {
      hint.textContent = 'Состав в заявке';
    }
  }

  function syncExt() {
    const t = currentTariff();
    const box = $('dr-ext-block');
    if (state.mode !== 'packs' || !t || !state.pack) { box.innerHTML = ''; return; }
    const onlyIncl = t.ext.length === 1 && t.ext[0].p === 0 && t.inclYm > 0;
    box.innerHTML = t.ext.map((e, i) => `
      <label class="drc-opt${onlyIncl || (e.p === 0 && t.inclYm > 0) ? ' is-incl' : ''}">
        <input type="radio" name="dr-ext" value="${e.v}"${i === 0 ? ' checked' : ''}>
        <span class="drc-opt__b"><b>Ярмарка игр</b> <span>${onlyIncl ? 'уже входит в пакет' : (t.inclYm > 0 && e.v === 0 ? 'входит в пакет' : 'программа продолжается')}</span></span>
        <span class="drc-opt__p">${e.p > 0 ? fmt(e.p) : (t.inclYm > 0 ? 'включено' : '0 ₽')}</span>
      </label>`).join('');
  }

  function syncVisibility() {
    const t = currentTariff();
    if (!t) return;
    const isMax = state.mode === 'packs' && state.pack === 'maximal';
    const isMini = state.mode === 'packs' ? state.pack === 'mini' : state.customBase === 'mini';
    setDisplay('dr-ext-block', state.mode === 'packs' && !!state.pack);
    setDisplay('dr-opt-menu', !t.food);
    setDisplay('dr-opt-video', !isMax);
    setDisplay('dr-opt-photo', !isMax);
    setDisplay('dr-opt-balls', !isMax);
    setDisplay('dr-opt-tort', !isMax);
    setDisplay('dr-opt-room2', !isMini);
    ['dr-video','dr-photo','dr-balls','dr-tort'].forEach((id) => {
      const input = $(id);
      const incl = isIncluded(id);
      input.disabled = incl;
      if (incl) input.checked = true;
    });
  }

  function syncGuests() {
    const t = currentTariff();
    if (!t) return;
    if (!state.guestsTouched) state.guests = t.minGuests;
    if (state.guests < t.minGuests) state.guests = t.minGuests;
    if (state.guests > MAX_GUESTS) state.guests = MAX_GUESTS;
    $('dr-guests').textContent = state.guests;
    $('dr-minus').disabled = state.guests <= t.minGuests;
    $('dr-plus').disabled = state.guests >= MAX_GUESTS;
    const note = $('dr-gnote');
    if (t.food) {
      note.textContent = state.guests <= t.freeGuests
        ? 'еда и напитки включены на ' + t.freeGuests + ' детей'
        : '+' + fmt(1000) + '/чел за каждого сверх ' + t.freeGuests;
    } else {
      note.textContent = 'в пакете до ' + t.freeGuests + ' гостей · дальше +' + fmt(1000) + '/чел';
    }
  }

  function collectExtras() {
    const extras = [];
    if (state.mode === 'packs') {
      if (currentExt() > 0) extras.push('Ярмарка игр +' + currentExt() + ' мин');
    } else if (customYm() > 0) {
      extras.push('Ярмарка игр ' + customYm() + ' мин');
    }
    if ($('dr-room-ext').checked) extras.push('продление комнаты ' + roomExtMinutes() + ' мин');
    if ($('dr-menu').checked) extras.push('меню под ключ');
    if ($('dr-video').checked) extras.push('видеосъёмка');
    if ($('dr-photo').checked) extras.push('фотосъёмка');
    if ($('dr-balls').checked) extras.push('гелиевые шары');
    if ($('dr-tort').checked) extras.push('тематический торт');
    if ($('dr-room2').checked) extras.push('вторая банкетная комната');
    return extras;
  }

  function crow(label, value, muted) {
    return '<div class="drc-catrow' + (muted ? ' is-muted' : '') + '"><span>' + label + '</span><b>' + value + '</b></div>';
  }
  function crowSp(s) {
    const i = s.lastIndexOf(' · ');
    return crow(i > -1 ? s.slice(0, i) : s, i > -1 ? s.slice(i + 3) : '', false);
  }
  function ccat(key, label, title, value, valueCls, subHtml) {
    const open = !!plateOpen[key];
    return '<div class="drc-cat">' +
      '<button type="button" class="drc-catbtn' + (open ? ' is-open' : '') + '" data-catbtn="' + key + '" aria-expanded="' + open + '">' +
        '<span class="l">' + (label ? '<span class="lbl">' + label + '</span>' : '') + '<span class="t">' + title + '</span></span>' +
        '<span class="r"><span class="v ' + valueCls + '">' + value + '</span><span class="chev">▾</span></span>' +
      '</button>' +
      '<div class="drc-catsub' + (open ? ' is-open' : '') + '" data-catsub="' + key + '">' + subHtml + '</div>' +
    '</div>';
  }

  function calculate() {
    const t = currentTariff();
    if (!t) return;
    const g = state.guests;
    const dateStr = $('dr-date').value;
    let total = t.price;
    const surList = [];
    if (t.food) {
      const foodExtra = Math.max(0, g - t.freeGuests);
      if (foodExtra > 0) { total += foodExtra * 1000; surList.push('Дети сверх ' + t.freeGuests + ' — еда (' + foodExtra + ' × 1 000 ₽) · ' + fmt(foodExtra * 1000)); }
      const progExtra = Math.max(0, g - 15);
      if (progExtra > 0) { total += progExtra * 1000; surList.push('Гости сверх 15 — программа (' + progExtra + ' × 1 000 ₽) · ' + fmt(progExtra * 1000)); }
    } else {
      const extra = Math.max(0, g - t.freeGuests);
      if (extra > 0) { total += extra * 1000; surList.push('Гости сверх ' + t.freeGuests + ' — программа (' + extra + ' × 1 000 ₽) · ' + fmt(extra * 1000)); }
    }
    const extrasList = [];
    let extrasSum = 0;
    const pushExtra = (name, price) => {
      extrasList.push(price != null ? name + ' · ' + fmt(price) : name);
      if (price) extrasSum += price;
    };
    const anyYm = state.mode === 'packs' ? currentExt() > 0 : customYm() > 0;
    if (anyYm) {
      const mins = state.mode === 'packs' ? currentExt() : customYm();
      pushExtra('Ярмарка игр +' + mins + ' мин', ymAddPrice());
    }
    if ($('dr-room-ext').checked) pushExtra('Продление комнаты ' + roomExtMinutes() + ' мин', roomExtMinutes() === 60 ? 2500 : 1250);
    if ($('dr-menu').checked && !t.food) pushExtra('Меню под ключ (' + g + ' × 1 000 ₽)', g * 1000);
    if ($('dr-video').checked && !isIncluded('dr-video')) pushExtra('Видеосъёмка', 4000);
    if ($('dr-photo').checked && !isIncluded('dr-photo')) pushExtra('Фотосъёмка', 6000);
    if ($('dr-balls').checked && !isIncluded('dr-balls')) pushExtra('Гелиевые шары', 3500);
    if ($('dr-tort').checked && !isIncluded('dr-tort')) {
      const foodCount = t.food ? Math.max(g, t.freeGuests) : ($('dr-menu').checked ? g : 0);
      if (foodCount > 0) pushExtra('Тематический торт (вычет −' + fmt(250 * foodCount) + ')', 7000 - 250 * foodCount);
      else pushExtra('Тематический торт', 7000);
    }
    if ($('dr-room2').checked) pushExtra('Вторая банкетная комната', null);

    total += extrasSum;
    const party = programHours() + roomExtMinutes() / 60;
    $('dr-duration').textContent = 'Праздник: ' + fmtH(party) + ' · весь слот: ' + fmtH(party + 0.5) + ' (+30 мин сборы)';

    const packSub = (t.includes || []).map((it) => crow(it, 'включено', true)).join('');
    let html = ccat('pack', 'Пакет', '«' + t.name + '»', fmt(t.price), 'is-money', packSub);

    const partySub =
      crow('Детей', g) +
      surList.map(crowSp).join('') +
      crow('Дата', dateStr ? dateStr.split('-').reverse().join('.') : 'уточним') +
      crow('Время', state.slot || 'уточним') +
      crow('Праздник', fmtH(party)) +
      crow('Весь слот', fmtH(party + 0.5));
    const surSum = surList.reduce((acc, s) => {
      const m = s.match(/(\d[\d\s\u00A0]*) ₽/);
      return acc + (m ? parseInt(m[1].replace(/[\s\u00A0]/g, ''), 10) : 0);
    }, 0);
    const partyVal = g + ' ' + plural(g, 'ребёнок', 'ребёнка', 'детей') + ' · ' + fmtH(party) + (surSum ? ' · +' + fmt(surSum) : '');
    html += ccat('party', '', 'Детали праздника', partyVal, '', partySub);

    let exTitle = 'Дополнительно';
    let exVal = 'не выбрано';
    let exCls = 'is-none';
    if (extrasList.length) {
      exTitle = 'Дополнительно · ' + extrasList.length + ' ' + plural(extrasList.length, 'услуга', 'услуги', 'услуг');
      exVal = extrasSum > 0 ? fmt(extrasSum) : 'по запросу';
      exCls = extrasSum > 0 ? 'is-money' : '';
    }
    const exSub = extrasList.length ? extrasList.map(crowSp).join('') : crow('ничего не выбрано', '', true);
    html += ccat('extras', '', exTitle, exVal, exCls, exSub);
    $('dr-breakdown').innerHTML = html;

    lastOrder = {
      tariff: t.name,
      tariffKey: state.mode === 'packs' ? state.pack : state.customBase,
      tariffPrice: t.price,
      includes: t.includes || [],
      guests: g,
      date: dateStr ? dateStr.split('-').reverse().join('.') : '',
      dateISO: dateStr || '',
      slot: state.slot || '',
      party: fmtH(party),
      slotFull: fmtH(party + 0.5),
      sur: surList,
      extras: extrasList,
      extrasSum: extrasSum,
      total: total
    };

    lastTotal = total;
    $('dr-total').textContent = fmt(total);
    $('dr-bar-total').textContent = fmt(total);
    $('dr-bar-total').nextElementSibling && null; // nothing

    dirty = snapshot ? hasChangesSinceSnapshot() : false;

    syncChooseBtns();
    syncBarHint();
    showCart();
    pushCalc();
  }

  function buildSummary(o) {
    if (!o) return '';
    const lines = [
      'Заявка с сайта xkalmar.com',
      '',
      '📦 ПАКЕТ', '«' + o.tariff + '» — ' + fmt(o.tariffPrice),
      'В пакет входит: ' + (o.includes || []).join(', '),
      '',
      '🎉 ВАШ ПРАЗДНИК', 'Детей: ' + o.guests
    ];
    (o.sur || []).forEach((s) => lines.push('· ' + s));
    lines.push(
      'Дата: ' + (o.date || 'уточним') + (o.slot ? ', время: ' + o.slot : ', время уточним'),
      'Длительность: ' + o.party + ' (весь слот ' + o.slotFull + ')',
      '', '➕ ДОПОЛНИТЕЛЬНО'
    );
    if (o.extras && o.extras.length) o.extras.forEach((e) => lines.push('· ' + e));
    else lines.push('· ничего сверх пакета');
    lines.push('', '💰 Итого по расчёту на сайте: ' + fmt(o.total));
    return lines.join('\n');
  }

  function pushCalc() {
    const t = currentTariff();
    if (!t) return;
    const c = window.DR_CALC;
    c.ready = true;
    c.tariff = t.name;
    c.guests = state.guests;
    c.date = $('dr-date').value || '';
    c.slot = state.slot || '';
    c.extras = collectExtras().join(', ');
    c.dirty = dirty;
    saveCalcState();
    try { document.dispatchEvent(new CustomEvent('drcalc-update')); } catch (e) {}
  }

  function pushSnapshot() {
    const c = window.DR_CALC;
    if (snapshot) { c.selected = true; c.order = snapshot; c.summary = buildSummary(snapshot); c.total = snapshot.total; }
    else { c.selected = false; c.order = null; c.summary = ''; c.total = 0; }
    c.dirty = dirty;
    saveCalcState();
    try { document.dispatchEvent(new CustomEvent('drcalc-update')); } catch (e) {}
  }

  function pick() {
    if (!lastOrder) return;
    snapshot = JSON.parse(JSON.stringify(lastOrder));
    dirty = false;
    window.DR_CALC.justUpdatedAt = Date.now();
    pushSnapshot();
    syncChooseBtns();
    syncBarHint();
    showCart();

    if (!window.__drToastShown) {
      window.__drToastShown = true;
      $('dr-toast').hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { $('dr-toast').hidden = true; }, 8000);
    } else {
      showMiniToast('Состав обновлён');
    }
  }

  function showMiniToast(text) {
    const el = $('dr-toast-mini');
    $('dr-toast-mini-text').textContent = text;
    el.hidden = false;
    clearTimeout(miniToastTimer);
    miniToastTimer = setTimeout(() => { el.hidden = true; }, 2500);
  }

  $('dr-breakdown').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-catbtn]');
    if (!btn) return;
    const key = btn.dataset.catbtn;
    plateOpen[key] = !plateOpen[key];
    btn.classList.toggle('is-open', plateOpen[key]);
    btn.setAttribute('aria-expanded', plateOpen[key] ? 'true' : 'false');
    const sub = document.querySelector('[data-catsub="' + key + '"]');
    if (sub) sub.classList.toggle('is-open', plateOpen[key]);
  });

  function saveCalcState() {
    try {
      const data = {
        mode: state.mode, pack: state.pack, customBase: state.customBase,
        customYm: state.customYm, guests: state.guests, guestsTouched: state.guestsTouched,
        date: $('dr-date').value || '', slot: state.slot || '',
        ext: document.querySelector('input[name="dr-ext"]:checked')?.value ?? null,
        roomExt: $('dr-room-ext').checked,
        rh: document.querySelector('input[name="dr-rh"]:checked')?.value || '30',
        menu: $('dr-menu').checked, video: $('dr-video').checked,
        photo: $('dr-photo').checked, balls: $('dr-balls').checked,
        tort: $('dr-tort').checked, room2: $('dr-room2').checked,
        snapshot: snapshot, dirty: dirty
      };
      localStorage.setItem(LS_KEY, JSON.stringify(data));
    } catch (e) {}
  }

  function restoreCalcState() {
    let d = null;
    try { d = JSON.parse(localStorage.getItem(LS_KEY) || 'null'); } catch (e) {}
    if (!d) return false;
    try {
      if (d.mode === 'custom') {
        state.mode = 'custom';
        state.customBase = TARIFFS[d.customBase] ? d.customBase : 'base';
        const cb = document.querySelector('input[name="dr-cbase"][value="' + state.customBase + '"]');
        if (cb) cb.checked = true;
      } else if (d.pack && TARIFFS[d.pack]) {
        state.mode = 'packs'; state.pack = d.pack;
        const pr = document.querySelector('input[name="dr-pack"][value="' + d.pack + '"]');
        if (pr) pr.checked = true;
      } else return false;

      if (typeof d.guests === 'number' && d.guests > 0) state.guests = d.guests;
      state.guestsTouched = !!d.guestsTouched;
      if (d.date) $('dr-date').value = d.date;
      if (d.slot) state.slot = d.slot;

      if (d.mode === 'custom') {
        const cymEl = document.querySelector('input[name="dr-cym"][value="' + (d.customYm || '0') + '"]');
        if (cymEl) cymEl.checked = true;
        state.customYm = d.customYm || '0';
      }
      if (d.roomExt) $('dr-room-ext').checked = true;
      const rh = document.querySelector('input[name="dr-rh"][value="' + (d.rh || '30') + '"]');
      if (rh) rh.checked = true;
      ['menu','video','photo','balls','tort','room2'].forEach((k) => { if (d[k]) $('dr-' + k).checked = true; });

      showSteps(true);
      recalcAll();

      if (d.mode === 'packs' && d.ext != null) {
        const er = document.querySelector('input[name="dr-ext"][value="' + d.ext + '"]');
        if (er) { er.checked = true; calculate(); }
      }
      if (d.snapshot) { snapshot = d.snapshot; dirty = !!d.dirty; }
      pushSnapshot();
      syncChooseBtns();
      syncBarHint();
      showCart();
      return true;
    } catch (e) { return false; }
  }

  function buildSlots() {
    const box = $('dr-slots');
    const t = currentTariff();
    if (!t) { box.innerHTML = ''; return; }
    const lastStart = CONFIG.endHour - slotHours();
    const labels = [];
    for (let h = CONFIG.startHour; h <= CONFIG.endHour; h++) { if (h > lastStart) break; labels.push((h < 10 ? '0' + h : h) + ':00'); }
    if (!labels.includes(state.slot)) state.slot = null;
    box.innerHTML = '';
    labels.forEach((label) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'drc-slot' + (label === state.slot ? ' is-active' : '');
      b.textContent = label;
      b.addEventListener('click', function () {
        if (state.slot === label) { state.slot = null; b.classList.remove('is-active'); }
        else { state.slot = label; box.querySelectorAll('.drc-slot').forEach((x) => x.classList.remove('is-active')); b.classList.add('is-active'); }
        calculate();
      });
      box.appendChild(b);
    });
  }

  function showSteps(show) {
    $('dr-steps').hidden = !show;
    $('dr-result').hidden = !show;
    if (!show) { $('dr-bar').hidden = true; $('dr-pill').hidden = true; }
  }

  function recalcAll() {
    syncExt(); syncVisibility(); syncGuests(); syncChooseBtns(); syncBarHint();
    buildSlots(); calculate(); showCart();
  }

  const stepOpen = [true, false, false, false];
  function renderSteps() {
    document.querySelectorAll('#dr-steps .drc-step').forEach((st, i) => {
      const body = st.querySelector('.drc-step__body');
      const head = st.querySelector('.drc-step__head');
      body.hidden = !stepOpen[i];
      head.classList.toggle('is-open', stepOpen[i]);
      head.setAttribute('aria-expanded', stepOpen[i] ? 'true' : 'false');
    });
  }
  document.querySelectorAll('#dr-steps .drc-step__head').forEach((h) => {
    h.addEventListener('click', () => { const i = Number(h.dataset.stephead); stepOpen[i] = !stepOpen[i]; renderSteps(); });
  });
  function openNext(i) { if (i < 3 && !stepOpen[i + 1]) { stepOpen[i + 1] = true; renderSteps(); } }

  function applyPack(el) {
    state.mode = 'packs';
    state.pack = el.value;
    const t = TARIFFS[el.value];
    if (!t) return;
    document.querySelectorAll('input[name="dr-cbase"], input[name="dr-cym"]').forEach((r) => (r.checked = false));
    state.customBase = 'base';
    state.customYm = '0';
    state.guests = state.guestsTouched ? Math.max(state.guests, t.minGuests) : t.minGuests;
    resetExtras();
    showSteps(true);
    barClosed = false;   // открыть корзину
    recalcAll();
  }

  document.querySelectorAll('input[name="dr-pack"]').forEach((el) => {
    el.addEventListener('change', () => applyPack(el));
  });

  document.querySelectorAll('input[name="dr-cbase"]').forEach((el) => {
    el.addEventListener('change', () => {
      state.mode = 'custom';
      state.pack = null;
      document.querySelectorAll('input[name="dr-pack"]').forEach((r) => (r.checked = false));
      state.customBase = el.value;
      const t = TARIFFS[el.value];
      state.guests = state.guestsTouched ? Math.max(state.guests, t.minGuests) : t.minGuests;
      showSteps(true);
      barClosed = false;
      recalcAll();
    });
  });
  document.querySelectorAll('input[name="dr-cym"]').forEach((el) => {
    el.addEventListener('change', () => { state.customYm = el.value; recalcAll(); });
  });

  $('dr-plus').addEventListener('click', () => { state.guests++; state.guestsTouched = true; recalcAll(); openNext(0); });
  $('dr-minus').addEventListener('click', () => { state.guests--; state.guestsTouched = true; recalcAll(); openNext(0); });

  ['dr-menu','dr-video','dr-photo','dr-balls','dr-tort','dr-room2'].forEach((id) => {
    $(id).addEventListener('change', calculate);
  });
  $('dr-room-ext').addEventListener('change', () => {
    $('dr-room-hours').hidden = !$('dr-room-ext').checked;
    buildSlots(); openNext(2); calculate();
  });
  document.getElementById('dr-ext-block').addEventListener('change', () => { buildSlots(); calculate(); openNext(2); });
  document.querySelectorAll('input[name="dr-rh"]').forEach((el) => el.addEventListener('change', () => { buildSlots(); calculate(); }));

  const dateInput = $('dr-date');
  const _d = new Date();
  dateInput.min = _d.getFullYear() + '-' + String(_d.getMonth()+1).padStart(2,'0') + '-' + String(_d.getDate()).padStart(2,'0');
  dateInput.addEventListener('change', () => { calculate(); openNext(1); });

  $('dr-preset').addEventListener('click', () => {
    document.querySelector('input[name="dr-cbase"][value="base"]').checked = true;
    document.querySelector('input[name="dr-cym"][value="60"]').checked = true;
    state.mode = 'custom'; state.customBase = 'base'; state.customYm = '60';
    document.querySelectorAll('input[name="dr-pack"]').forEach((r) => (r.checked = false));
    state.pack = null;
    state.guests = state.guestsTouched ? Math.max(state.guests, 5) : 5;
    resetExtras();
    $('dr-menu').checked = true; $('dr-photo').checked = true; $('dr-balls').checked = true;
    showSteps(true);
    barClosed = false;
    recalcAll();
  });

  function openChannels(title, text) {
    $('dr-modal-title').textContent = title;
    $('dr-chan-wa').href = 'https://wa.me/' + CONFIG.wa + '?text=' + encodeURIComponent(text);
    $('dr-chan-tg').href = 'https://t.me/' + CONFIG.tg + '?text=' + encodeURIComponent(text);
    $('dr-chan-max').href = CONFIG.max;
    $('dr-chan-tel').href = 'tel:' + CONFIG.tel;
    $('dr-modal').hidden = false;
  }
  function closeChannels() { $('dr-modal').hidden = true; }
  $('dr-modal-x').addEventListener('click', closeChannels);
  $('dr-modal').addEventListener('click', (e) => { if (e.target === $('dr-modal')) closeChannels(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeChannels(); });

  /* «Забронировать» = pick() (если нужно) + скролл к форме */
  function book() {
    if (!snapshot || dirty) pick();
    const anchor = document.getElementById('zayavka');
    if (anchor) {
      $('dr-toast').hidden = true;
      $('dr-bar').hidden = true;
      barClosed = true;
      anchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
      showCart();
      return;
    }
    openChannels('Заявка на праздник', window.DR_CALC.summary || 'Здравствуйте! Хочу забронировать праздник.');
  }

  function onClickChoose() {
    if (!snapshot || dirty) { pick(); return; }
    showMiniToast('Состав уже в заявке — можно отправлять');
  }

  function help() { openChannels('Помочь с расчётом', 'Здравствуйте! Помогите рассчитать праздник.\n\n' + (window.DR_CALC.summary || '')); }
  function offer() { openChannels('Обсудить условия', 'Здравствуйте! Нашёл похожее дешевле — обсудим?'); }

  $('dr-toast-go').addEventListener('click', () => { $('dr-toast').hidden = true; book(); });
  $('dr-toast-stay').addEventListener('click', () => { $('dr-toast').hidden = true; });
  $('dr-bar-choose').addEventListener('click', onClickChoose);
  $('dr-choose').addEventListener('click', onClickChoose);
  $('dr-book').addEventListener('click', book);
  $('dr-bar-book').addEventListener('click', book);
  $('dr-help').addEventListener('click', help);

  $('dr-bar-close').addEventListener('click', () => {
    barClosed = true;
    showCart();
  });
  $('dr-pill').addEventListener('click', () => {
    barClosed = false;
    showCart();
  });

  function doReset() {
    try { localStorage.removeItem(LS_KEY); } catch (e) {}
    ['dr-menu','dr-video','dr-photo','dr-balls','dr-tort','dr-room2','dr-room-ext'].forEach((id) => { $(id).checked = false; });
    $('dr-room-hours').hidden = true;
    document.querySelectorAll('input[name="dr-pack"], input[name="dr-cbase"], input[name="dr-cym"]').forEach((i) => (i.checked = false));
    $('dr-date').value = '';
    state.mode = 'packs'; state.pack = null;
    state.customBase = 'base'; state.customYm = '0';
    state.guests = 6; state.guestsTouched = false; state.slot = null;
    stepOpen[0] = true; stepOpen[1] = false; stepOpen[2] = false; stepOpen[3] = false;
    snapshot = null; dirty = false; barClosed = true;
    window.__drToastShown = false;
    window.DR_CALC.justUpdatedAt = 0;

    syncChooseBtns(); syncBarHint(); showCart();
    showSteps(false);
    window.DR_CALC.ready = false;
    pushSnapshot();
    document.querySelector('.drc__cards').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  $('dr-reset').addEventListener('click', doReset);
  $('dr-bar-reset').addEventListener('click', doReset);

  restoreCalcState();
  renderSteps();
</script>