  const MAX_GUESTS = 20;
  const LS_KEY = 'xkalmar-calc-v1';

  const TARIFFS = {
    popular:  { name: 'Популярный',  price: 24000, freeGuests: 15, minGuests: 5, program: 2.5, food: false, inclYm: 30, ymDefault: 30, ymIncl: 4000,
                includes: [ 'Квест-приключение 1,5 ч (команда из 3 ведущих-актёров)', 'Подвижные игры 30 мин с призами', 'Праздничный стол 30 мин' ] },
    optimal:  { name: 'Оптимальный', price: 33500, freeGuests: 6,  minGuests: 6, program: 3, food: true, inclYm: 60, ymDefault: 60, ymIncl: 7500,
                includes: [ 'Квест-приключение 1,5 ч — полный сценарий (команда из 3 ведущих-актёров)', 'Подвижные игры 1 ч с призами: интерактивная стена, кидалка, «Угадай напиток», вышибалы, мафия — на выбор', 'Банкет под ключ: сервировка, еда, напитки, порционный торт' ] },
    maximal:  { name: 'Максимальный', price: 50000, freeGuests: 6, minGuests: 6, program: 3.5, food: true, inclYm: 60, ymDefault: 60, ymIncl: 7500, core: 27500,
                includes: [ 'Квест-приключение — расширенный сценарий (команда из 3 ведущих-актёров)', 'Подвижные игры 1 ч с призами: интерактивная стена, кидалка, «Угадай напиток», вышибалы, мафия — на выбор', 'Подарок каждому ребёнку' ] },
    base:     { name: 'База', price: 20000, freeGuests: 15, minGuests: 5, program: 2, food: false, inclYm: 0, ymDefault: 0, ymIncl: 0,
                includes: [ 'Квест-приключение 1,5 ч', 'Банкет 30 мин' ] },
    mini:     { name: 'Мини', price: 15000, freeGuests: 8, minGuests: 5, program: 1.5, food: false, inclYm: 0, ymDefault: 0, ymIncl: 0,
                includes: [ 'Квест 1 ч', 'Банкет 30 мин' ] }
  };

  const state = {
    mode: 'packs',
    pack: null,
    customBase: 'base',
    customYm: '0',
    guests: 6, slot: null, guestsTouched: false,
    date: '',
    extSel: undefined,
    packModified: false
  };
  let lastTotal = 0;
  let lastOrder = null;
  let snapshot = null;
  let dirty = false;
  let prevDirty = false;
  let toastTimer = null;
  let addedTimer = null;
  let tariffLabelG = '';
  let packPriceG = 0;

  window.DR_CALC = {
    ready: false, selected: false, tariff: '', guests: 0,
    date: '', slot: '', extras: '', total: 0, summary: '', order: null,
    dirty: false, justUpdatedAt: 0, sent: false
  };

  const $ = (id) => document.getElementById(id);
  const fmt = (n) => n.toLocaleString('ru-RU') + ' ₽';
  const fmtH = (h) => String(h).replace('.', ',') + ' ч';

  function plural(n, one, few, many) {
    const m10 = n % 10, m100 = n % 100;
    if (m10 === 1 && m100 !== 11) return one;
    if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
    return many;
  }

  function currentTariff() {
    return state.mode === 'packs' ? TARIFFS[state.pack] : TARIFFS[state.customBase];
  }

  function currentExt() {
    if (state.mode !== 'packs') return 0;
    const t = currentTariff();
    if (state.extSel === undefined) return (t && t.ymDefault != null) ? t.ymDefault : 0;
    return state.extSel;
  }

  function customYm() { return parseInt(state.customYm, 10) || 0; }
  
  function roomExtMinutes() {
    const cb = $('dr-room-ext');
    if (!cb || !cb.checked) return 0;
    const sel = document.querySelector('input[name="dr-rh"]:checked');
    return sel ? parseInt(sel.value, 10) : 30;
  }

  function programHours() {
    const t = currentTariff();
    if (!t) return 0;
    const cur = currentExt();
    const extMins = state.mode === 'packs' ? ((cur === null ? 0 : cur) - t.ymDefault) : customYm();
    return t.program + extMins / 60;
  }

  function slotHours() { return programHours() + 0.5 + roomExtMinutes() / 60; }
  
  function resetExtras() {
    ['dr-menu','dr-video','dr-photo','dr-balls','dr-tort','dr-room2','dr-room-ext','dr-banquet'].forEach((id) => { 
      const el = $(id); if(el) el.checked = false; 
    });
    const rh = $('dr-room-hours'); if(rh) rh.hidden = true;
  }

  function hasChangesSinceSnapshot() {
    if (!snapshot || !lastOrder) return false;
    if (snapshot.tariffKey !== lastOrder.tariffKey) return true;
    if (snapshot.tariff !== lastOrder.tariff) return true;
    if (snapshot.tariffPrice !== lastOrder.tariffPrice) return true;
    if (snapshot.guests !== lastOrder.guests) return true;
    if (snapshot.dateISO !== lastOrder.dateISO) return true;
    if (snapshot.slot !== lastOrder.slot) return true;
    if ((snapshot.extras || []).join('|') !== (lastOrder.extras || []).join('|')) return true;
    return false;
  }

  function updateActionButtons() {
    const btnSheet = $('dr-sheet-book');
    if (!btnSheet) return;

    let text = 'Добавить к заявке';
    let isDisabled = false;
    
    const sent = !!(window.DR_CALC && window.DR_CALC.sent);
    if (snapshot) {
      text = dirty ? (sent ? 'Обновить заявку' : 'Перенести изменения') : 'Перейти к заявке';
    }
    
    if (!state.pack && state.mode === 'packs') isDisabled = true;
    if (state.mode === 'custom' && !state.customBase) isDisabled = true;
    if (lastTotal && lastTotal < 15000) isDisabled = true;

    btnSheet.textContent = text;
    btnSheet.disabled = isDisabled;
  }

  function showCart() {
    const hasCart = !!(state.mode === 'packs' ? state.pack : state.customBase);
    const pill = $('dr-pill');
    if (!pill) return;
    
    if (hasCart) {
      pill.hidden = false;
    } else {
      pill.hidden = true;
      const sheet = $('dr-sheet'); if(sheet) sheet.hidden = true;
    }
  }

  function syncCart() {
    const t = currentTariff();
    if (!t) return;
    
    const baseCnt = 1;
    const extrasCnt = collectExtras().length;
    const totalCnt = baseCnt + extrasCnt;
    
    const pill = $('dr-pill');
    const pillTotal = $('dr-pill-total');
    const pillCount = $('dr-pill-count');
    const dot = $('dr-pill-dot');
    
    if (!pill || !pillTotal || !pillCount) return;
    
    pillTotal.textContent = fmt(lastTotal);
    pillCount.textContent = totalCnt + ' ' + plural(totalCnt, 'позиция', 'позиции', 'позиций');
    
    if (!dirty) {
      if (dot) dot.hidden = true;
    } else {
      if (dot) {
        if (dot.hidden) {
          dot.hidden = false;
          dot.classList.add('is-pulse');
          setTimeout(() => dot.classList.remove('is-pulse'), 2000);
        }
      }
    }
    updateActionButtons();
  }

  function syncProgramUI() {
    const isPacks = state.mode === 'packs';
    const pp = $('dr-program-packs');
    const pc = $('dr-program-custom');
    const rs = $('dr-pack-restore');
    
    if (pp) pp.hidden = !isPacks;
    if (pc) pc.hidden = isPacks;
    
    if (isPacks && state.pack) {
      const pn = $('dr-program-name');
      if (pn) {
        pn.textContent = state.packModified ? 'Свой формат (на базе «' + TARIFFS[state.pack].name + '»)' : '«' + TARIFFS[state.pack].name + '»';
      }
      if (rs) rs.hidden = !state.packModified;
    }
    
    const eb = $('dr-ext-block');
    const yc = $('dr-ym-custom');
    if (eb) eb.hidden = !(state.mode === 'packs' && !!state.pack);
    if (yc) yc.hidden = !(state.mode === 'custom');
  }

  function syncExt() {
    const t = currentTariff();
    const box = $('dr-ext-block');
    if (!box) return;
    if (state.mode !== 'packs' || !t || !state.pack) { box.innerHTML = ''; return; }
    const cur = currentExt();
    const inclMin = t.ymDefault || 0;
    const isIncl = (v) => (t.ymIncl || 0) > 0 && v === inclMin;
    const isPartial = (v) => (t.ymIncl || 0) > 0 && v > inclMin;
    const row = (v, base) => {
      const incl = isIncl(v);
      const partial = isPartial(v);
      const priceStr = incl ? (fmt(base) + ' · в пакете')
                    : partial ? ('+' + fmt(base - t.ymIncl))
                    : fmt(base);
      const checked = (cur === v) ? 'checked' : '';
      return `
      <label class="drc-opt${incl ? ' is-incl' : ''}">
        <input type="radio" name="dr-ext" value="${v}" ${checked}>
        <span class="drc-opt__b"><b>Ярмарка игр ${v} мин</b>${partial ? '<span>сверх пакета</span>' : ''}</span>
        <span class="drc-opt__p${incl ? ' drc-opt__p--incl' : ''}">${priceStr}</span>
      </label>`;
    };
    const removed = (cur === null) && (t.ymIncl || 0) > 0;
    box.innerHTML = row(30, 4000) + row(60, 7500) +
      (removed ? '<span class="drc-hint" style="margin-top:2px;">Ярмарка не выбрана — из расчёта вычтено ' + fmt(t.ymIncl) + '</span>' : '');
  }

  function syncVisibility() {
    const t = currentTariff();
    if (!t) return;
    const isMax = state.mode === 'packs' && state.pack === 'maximal';
    const isMini = state.mode === 'packs' ? state.pack === 'mini' : state.customBase === 'mini';
    
    const banqOn = isMax ? ($('dr-banquet') ? $('dr-banquet').checked : true) : false;
    const foodOn = state.mode === 'custom' ? false : (isMax ? banqOn : t.food);
    
    const setDisplay = (id, show) => { const el = $(id); if(el) el.style.display = show ? '' : 'none'; };
    
    setDisplay('dr-opt-menu', !foodOn);
    setDisplay('dr-opt-banquet', isMax);
    setDisplay('dr-opt-room2', !isMini);
    
    const vin = $('dr-video'); if (vin) vin.disabled = false;
    
    const mark = (id, on) => { const wrap = $(id); if (!wrap) return; const m = wrap.querySelector('.drc-opt__incl'); if (m) m.hidden = !on; };
    mark('dr-opt-banquet', isMax); mark('dr-opt-photo', isMax); mark('dr-opt-balls', isMax); mark('dr-opt-tort', isMax);
  }

  function syncGuests() {
    const t = currentTariff();
    if (!t) return;
    if (!state.guestsTouched) state.guests = t.minGuests;
    if (state.guests < t.minGuests) state.guests = t.minGuests;
    if (state.guests > MAX_GUESTS) state.guests = MAX_GUESTS;
    
    const gOut = $('dr-guests'); if(gOut) gOut.textContent = state.guests;
    const btnMinus = $('dr-minus'); if(btnMinus) btnMinus.disabled = state.guests <= t.minGuests;
    const btnPlus = $('dr-plus'); if(btnPlus) btnPlus.disabled = state.guests >= MAX_GUESTS;
    
    const isMax = state.mode === 'packs' && state.pack === 'maximal';
    const banqOn = isMax ? ($('dr-banquet') ? $('dr-banquet').checked : false) : false;
    const foodOn = state.mode === 'custom' ? false : (isMax ? banqOn : t.food);
    const progLimit = (isMax && !banqOn) ? 15 : t.freeGuests;
    
    const note = $('dr-gnote');
    if (note) {
      if (foodOn) {
        note.textContent = state.guests <= t.freeGuests
          ? 'еда и напитки включены на ' + t.freeGuests + ' детей'
          : '+' + fmt(1000) + '/чел за каждого сверх ' + t.freeGuests;
      } else {
        note.textContent = 'программа до ' + progLimit + ' детей · дальше +' + fmt(1000) + '/чел';
      }
    }
  }

  function collectExtras() {
    const extras = [];
    const isChecked = (id) => { const el = $(id); return el && el.checked; };

    const t = currentTariff();
    const isMax = state.mode === 'packs' && state.pack === 'maximal';
    const banqOn = isMax ? isChecked('dr-banquet') : false;
    const foodOn = state.mode === 'custom' ? false : (isMax ? banqOn : t.food);

    if (state.mode === 'packs') {
      const curExtVal = currentExt();
      if (curExtVal !== null && (curExtVal - t.ymDefault) > 0) {
        extras.push('Ярмарка игр +' + (curExtVal - t.ymDefault) + ' мин');
      }
    } else if (customYm() > 0) {
      extras.push('Ярмарка игр ' + customYm() + ' мин');
    }
    if (isChecked('dr-video')) extras.push('видеосъёмка');
    if (isChecked('dr-photo') && !isMax) extras.push('фотосъёмка');
    if (isChecked('dr-balls') && !isMax) extras.push('гелиевые шары');
    if (isChecked('dr-tort') && !isMax) extras.push('тематический торт');
    if (isChecked('dr-menu') && !foodOn) extras.push('меню под ключ');
    if (isChecked('dr-room-ext')) extras.push('продление комнаты ' + roomExtMinutes() + ' мин');
    if (isChecked('dr-room2')) extras.push('вторая банкетная комната');
    return extras;
  }

  function calculate() {
    const t = currentTariff();
    if (!t) return;
    const g = state.guests;
    const dateStr = $('dr-date') ? $('dr-date').value : '';
    const isChecked = (id) => { const el = $(id); return !!(el && el.checked); };
    const isMax = state.mode === 'packs' && state.pack === 'maximal';
    const banqOn = isMax ? isChecked('dr-banquet') : false;
    const foodOn = state.mode === 'custom' ? false : (isMax ? banqOn : t.food);
    const progLimit = (isMax && !banqOn) ? 15 : t.freeGuests;
    
    const curExtVal = currentExt();
    const ymRemoved = (state.mode === 'packs') && curExtVal === null && (t.ymIncl || 0) > 0;
    const isModified = (state.mode === 'packs') && (curExtVal === null || (curExtVal !== null && curExtVal < t.ymDefault));
    
    let packPrice = (isMax && t.core) ? t.core : t.price;
    let incList = (t.includes || []).slice();
    const surList = [];

    if (isModified) {
      packPrice -= (t.ymIncl || 0);
      if (curExtVal === 30) packPrice += 4000;
      incList = incList.filter((s) => s.indexOf('Подвижные игры') === -1);
      if (curExtVal === null) {
        surList.push('Ярмарка снята (−' + fmt(t.ymIncl) + ')');
      } else {
        surList.push('Ярмарка 30 мин вместо ' + t.ymDefault + ' (−' + fmt((t.ymIncl || 0) - 4000) + ')');
        incList.push('Подвижные игры 30 мин с призами');
      }
    }

    if (isMax) {
      const maxItems = [
        { id: 'dr-banquet', price: 6000, inc: 'Банкет под ключ' },
        { id: 'dr-balls', price: 3500, inc: 'Гелиевые шары' },
        { id: 'dr-photo', price: 6000, inc: 'Фотосъёмка' },
        { id: 'dr-tort', price: 7000, inc: 'Большой торт от кондитера' }
      ];
      maxItems.forEach((m) => {
        if (isChecked(m.id)) {
          packPrice += m.price;
          incList.push(m.inc);
        }
      });
    }

    let total = packPrice;

    if (foodOn) {
      const foodExtra = Math.max(0, g - t.freeGuests);
      if (foodExtra > 0) { total += foodExtra * 1000; surList.push('Дети сверх ' + t.freeGuests + ' — еда (' + foodExtra + ' × 1 000 ₽) · ' + fmt(foodExtra * 1000)); }
      const progExtra = Math.max(0, g - progLimit);
      if (progExtra > 0) { total += progExtra * 1000; surList.push('Гости сверх ' + progLimit + ' — программа (' + progExtra + ' × 1 000 ₽) · ' + fmt(progExtra * 1000)); }
    } else {
      const extra = Math.max(0, g - progLimit);
      if (extra > 0) { total += extra * 1000; surList.push('Гости сверх ' + progLimit + ' — программа (' + extra + ' × 1 000 ₽) · ' + fmt(extra * 1000)); }
    }

    const extrasList = [];
    let extrasSum = 0;
    const pushExtra = (name, price) => {
      extrasList.push(price != null ? name + ' · ' + fmt(price) : name);
      if (price) extrasSum += price;
    };
    
    const anyYm = state.mode === 'packs' ? (curExtVal !== null && curExtVal > t.ymDefault) : customYm() > 0;
    if (anyYm) {
      const mins = state.mode === 'packs' ? Math.max(0, curExtVal - t.ymDefault) : customYm();
      if (mins > 0) {
        pushExtra('Ярмарка игр +' + mins + ' мин', curExtVal === 60 ? 3500 : 0);
      }
    }
    if ($('dr-menu') && $('dr-menu').checked && !foodOn) pushExtra('Меню под ключ (' + g + ' × 1 000 ₽)', g * 1000);
    if ($('dr-video') && $('dr-video').checked) pushExtra('Видеосъёмка', 4000);
    if ($('dr-photo') && $('dr-photo').checked && !isMax) pushExtra('Фотосъёмка', 6000);
    if ($('dr-balls') && $('dr-balls').checked && !isMax) pushExtra('Гелиевые шары', 3500);
    
    if (isMax) {
      if (isChecked('dr-tort')) pushExtra('Тематический торт', 7000);
    } else {
      if ($('dr-tort') && $('dr-tort').checked) {
        const foodCount = foodOn ? Math.max(g, t.freeGuests) : ($('dr-menu') && $('dr-menu').checked ? g : 0);
        if (foodCount > 0) pushExtra('Тематический торт (вычет −' + fmt(250 * foodCount) + ')', Math.max(0, 7000 - 250 * foodCount));
        else pushExtra('Тематический торт', 7000);
      }
    }

    if ($('dr-room-ext') && $('dr-room-ext').checked) pushExtra('Продление комнаты ' + roomExtMinutes() + ' мин', roomExtMinutes() === 60 ? 2500 : 1250);
    if ($('dr-room2') && $('dr-room2').checked) pushExtra('Вторая банкетная комната', null);

    total += extrasSum;
    const party = programHours() + roomExtMinutes() / 60;
    
    state.packModified = (state.mode === 'packs') && (ymRemoved || isModified || (isMax && ['dr-banquet','dr-balls','dr-photo','dr-tort'].some((id) => !isChecked(id))));
    tariffLabelG = state.packModified ? 'Свой формат (на базе «' + t.name + '»)' : t.name;
    packPriceG = packPrice;

    lastOrder = {
      tariff: tariffLabelG,
      tariffKey: state.mode === 'packs' ? state.pack : state.customBase,
      tariffPrice: packPrice,
      includes: incList,
      guests: g,
      date: dateStr ? dateStr.split('-').reverse().join('.') : '',
      dateISO: dateStr || '',
      slot: state.slot || '',
      party: fmtH(party),
      slotFull: fmtH(party + 0.5),
      sur: surList,
      extras: extrasList,
      extrasSum: extrasSum,
      total: total
    };

    lastTotal = total;
    dirty = snapshot ? hasChangesSinceSnapshot() : false;
    prevDirty = dirty;

    syncCart();
    showCart();
    pushCalc();
  }

  function buildSummary(o) {
    if (!o) return '';
    const lines = [
      'Заявка с сайта xkalmar.com',
      '',
      '📦 ПАКЕТ', '«' + o.tariff + '» — ' + fmt(o.tariffPrice),
      'В пакет входит: ' + (o.includes || []).join(', '),
      '', '🎉 ВАШ ПРАЗДНИК', 'Детей: ' + o.guests
    ];
    (o.sur || []).forEach((s) => lines.push('· ' + s));
    lines.push(
      'Дата: ' + (o.date || 'уточним') + (o.slot ? ', время: ' + o.slot : ', время уточним'),
      'Длительность: ' + o.party + ' (весь слот ' + o.slotFull + ')',
      '', '➕ ДОПОЛНИТЕЛЬНО'
    );
    if (o.extras && o.extras.length) o.extras.forEach((e) => lines.push('· ' + e));
    else lines.push('· ничего сверх пакета');
    lines.push('', '💰 Итого по расчёту на сайте: ' + fmt(o.total));
    return lines.join('\n');
  }

  function pushCalc() {
    const t = currentTariff();
    if (!t) return;
    const c = window.DR_CALC;
    c.ready = true;
    c.tariff = t.name;
    c.guests = state.guests;
    c.date = $('dr-date') ? $('dr-date').value : '';
    c.slot = state.slot || '';
    c.extras = collectExtras().join(', ');
    c.dirty = dirty;
    saveCalcState();
    try { document.dispatchEvent(new CustomEvent('drcalc-update')); } catch (e) {}
  }

  function pushSnapshot() {
    const c = window.DR_CALC;
    if (snapshot) { c.selected = true; c.order = snapshot; c.summary = buildSummary(snapshot); c.total = snapshot.total; }
    else { c.selected = false; c.order = null; c.summary = ''; c.total = 0; }
    c.dirty = dirty;
    saveCalcState();
    try { document.dispatchEvent(new CustomEvent('drcalc-update')); } catch (e) {}
  }

  function pick() {
    if (!lastOrder) return;
    const changed = !snapshot || dirty;
    if (changed) {
      snapshot = JSON.parse(JSON.stringify(lastOrder));
      dirty = false;
      prevDirty = false;
      window.DR_CALC.justUpdatedAt = Date.now();
      pushSnapshot();
      syncCart();
      showCart();
      closeSheet();
      const btnSheet = $('dr-sheet-book');
      if (btnSheet) {
        btnSheet.textContent = 'Добавлено ✓';
        clearTimeout(addedTimer);
        addedTimer = setTimeout(() => { updateActionButtons(); }, 2000);
      }
      const toast = $('dr-toast');
      if (toast) {
        toast.hidden = false;
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => { toast.hidden = true; }, 8000);
      }
    } else {
      closeSheet();
      const anchor = document.getElementById('zayavka');
      if (anchor) anchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function openSheet() { renderSheet(); const s = $('dr-sheet'); if(s) s.hidden = false; }
  function closeSheet() { const s = $('dr-sheet'); if(s) s.hidden = true; }

  function renderSheet() {
    const t = currentTariff();
    const list = $('dr-sheet-list');
    if (!t || !list) return;
    const rows = [];
    const isChecked = (id) => { const el = $(id); return !!(el && el.checked); };
    const isMax = state.mode === 'packs' && state.pack === 'maximal';
    
    rows.push({ key: 'pack', label: state.packModified ? 'Свой формат (на базе «' + t.name + '»)' : 'Пакет «' + t.name + '»', price: fmt(packPriceG), fixed: true });

    const curExtVal = currentExt();
    const ymRemoved = (state.mode === 'packs') && curExtVal === null && (t.ymIncl || 0) > 0;
    if (ymRemoved) rows.push({ key: 'ym-off', label: 'Ярмарка снята', price: '−' + fmt(t.ymIncl), fixed: true });

    if (isMax) {
      const maxItems = [
        { id: 'dr-banquet', key: 'banquet', price: 6000, inc: 'Банкет под ключ' },
        { id: 'dr-balls', key: 'balls', price: 3500, inc: 'Гелиевые шары' },
        { id: 'dr-photo', key: 'photo', price: 6000, inc: 'Фотосъёмка' },
        { id: 'dr-tort', key: 'tort', price: 7000, inc: 'Большой торт от кондитера' }
      ];
      maxItems.forEach((m) => {
        if (isChecked(m.id)) rows.push({ key: m.key, label: m.inc, price: fmt(m.price), fixed: true });
      });
    }

    if ($('dr-video') && $('dr-video').checked) rows.push({ key: 'video', label: 'Видеосъёмка', price: fmt(4000), fixed: false });

    if (!isMax) {
      if ($('dr-menu') && $('dr-menu').checked) rows.push({ key: 'menu', label: 'Меню под ключ', price: fmt(state.guests * 1000), fixed: false });
      if ($('dr-photo') && $('dr-photo').checked) rows.push({ key: 'photo', label: 'Фотосъёмка', price: fmt(6000), fixed: false });
      if ($('dr-balls') && $('dr-balls').checked) rows.push({ key: 'balls', label: 'Гелиевые шары', price: fmt(3500), fixed: false });
      if ($('dr-tort') && $('dr-tort').checked) {
        const foodCount = t.food ? Math.max(state.guests, t.freeGuests) : (($('dr-menu') && $('dr-menu').checked) ? state.guests : 0);
        rows.push({ key: 'tort', label: 'Торт', price: fmt(foodCount > 0 ? Math.max(0, 7000 - 250 * foodCount) : 7000), fixed: false });
      }
    }
    
    if ($('dr-room-ext') && $('dr-room-ext').checked) rows.push({ key: 'room-ext', label: 'Продление комнаты ' + roomExtMinutes() + ' мин', price: fmt(roomExtMinutes() === 60 ? 2500 : 1250), fixed: false });
    if ($('dr-room2') && $('dr-room2').checked) rows.push({ key: 'room2', label: 'Вторая комната', price: 'по запросу', fixed: false });

    if (!rows.length) {
      list.innerHTML = '<p class="drc-sheet__empty">Корзина пуста</p>';
    } else {
      list.innerHTML = rows.map(r => `
        <div class="drc-sheet__row${r.fixed ? ' is-hidden' : ''}">
          <span>${r.label}</span>
          <b>${r.price}</b>
          <button type="button" data-remove="${r.key}" aria-label="Удалить">✕</button>
        </div>`).join('');
    }
    const tot = $('dr-sheet-total'); if(tot) tot.textContent = fmt(lastTotal);
  }

  function bindEvents() {
    const bind = (id, ev, fn) => { const el = $(id); if(el) el.addEventListener(ev, fn); };

    bind('dr-sheet-list', 'click', (e) => {
      const btn = e.target.closest('[data-remove]');
      if (!btn) return;
      const key = btn.dataset.remove;
      if (key === 'ym-off') { state.extSel = undefined; }
      if (key === 'room-ext') { const r = $('dr-room-ext'); if(r) r.checked = false; const h = $('dr-room-hours'); if(h) h.hidden = true; }
      if (key === 'menu') { const r = $('dr-menu'); if(r) r.checked = false; }
      if (key === 'video') { const r = $('dr-video'); if(r) r.checked = false; }
      if (key === 'photo') { const r = $('dr-photo'); if(r) r.checked = false; }
      if (key === 'balls') { const r = $('dr-balls'); if(r) r.checked = false; }
      if (key === 'tort') { const r = $('dr-tort'); if(r) r.checked = false; }
      if (key === 'room2') { const r = $('dr-room2'); if(r) r.checked = false; }
      if (key === 'banquet') { const r = $('dr-banquet'); if(r) r.checked = false; }
      
      recalcAll();
      renderSheet();
    });

    bind('dr-sheet-bg', 'click', closeSheet);
    bind('dr-sheet-x', 'click', closeSheet);
    bind('dr-sheet-clear', 'click', () => { doReset(); closeSheet(); });
    bind('dr-pill', 'click', openSheet);

    document.querySelectorAll('[data-more]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const key = btn.dataset.more;
        const det = document.querySelector('[data-details="' + key + '"]');
        if (det) det.hidden = !det.hidden;
      });
    });

    document.querySelectorAll('input[name="dr-pack"]').forEach((el) => {
      el.addEventListener('change', () => setPack(el.value));
    });

    document.querySelectorAll('input[name="dr-cbase"]').forEach((el) => {
      el.addEventListener('change', () => setCustom(el.value));
    });
    
    const yc = $('dr-ym-custom');
    if (yc) {
      yc.addEventListener('click', (e) => {
        const inp = e.target.closest('input[name="dr-cym"]');
        if (!inp) return;
        if (String(customYm()) !== inp.value) return;
        e.preventDefault();
        inp.checked = false;
        state.customYm = '0';
        recalcAll();
      });
    }
    document.querySelectorAll('input[name="dr-cym"]').forEach((el) => {
      el.addEventListener('change', () => { state.customYm = el.value; recalcAll(); });
    });

    bind('dr-custom-trigger', 'click', () => setCustom('base'));
    bind('dr-mini-trigger', 'click', () => setPack('mini'));
    bind('dr-to-custom', 'click', () => setCustom('base'));
    bind('dr-to-packs', 'click', () => {
      const lastPack = state.pack || 'popular';
      setPack(lastPack);
    });

    bind('dr-pack-restore', 'click', () => {
      state.extSel = undefined;
      if (state.pack === 'maximal') {
        ['dr-banquet','dr-balls','dr-photo','dr-tort'].forEach((id) => { const el = $(id); if (el) el.checked = true; });
      }
      recalcAll();
    });

    bind('dr-plus', 'click', () => { state.guests++; state.guestsTouched = true; recalcAll(); openNext(1); });
    bind('dr-minus', 'click', () => { state.guests--; state.guestsTouched = true; recalcAll(); openNext(1); });

    ['dr-menu','dr-video','dr-photo','dr-balls','dr-tort','dr-room2','dr-banquet'].forEach((id) => {
      bind(id, 'change', calculate);
    });
    
    bind('dr-room-ext', 'change', () => {
      const h = $('dr-room-hours'); if(h) h.hidden = !$('dr-room-ext').checked;
      buildSlots(); openNext(3); calculate();
    });
    
    const eb = $('dr-ext-block');
    if (eb) {
      eb.addEventListener('click', (e) => {
        const inp = e.target.closest('input[name="dr-ext"]');
        if (!inp) return;
        const cur = currentExt();
        if (cur === null || String(cur) !== inp.value) return;
        e.preventDefault();
        inp.checked = false;
        state.extSel = null;
        syncExt(); buildSlots(); calculate(); renderSheet();
      });
      eb.addEventListener('change', (e) => {
        const inp = e.target.closest('input[name="dr-ext"]');
        if (!inp) return;
        state.extSel = parseInt(inp.value, 10);
        syncExt(); buildSlots(); calculate(); openNext(3);
      });
    }
    
    document.querySelectorAll('input[name="dr-rh"]').forEach((el) => el.addEventListener('change', () => { buildSlots(); calculate(); }));

    const dateInput = $('dr-date');
    if (dateInput) {
      const _d = new Date();
      dateInput.min = _d.getFullYear() + '-' + String(_d.getMonth()+1).padStart(2,'0') + '-' + String(_d.getDate()).padStart(2,'0');
      dateInput.addEventListener('change', () => { calculate(); openNext(2); });
    }

    document.querySelectorAll('.drc-step__head').forEach((h) => {
      h.addEventListener('click', () => { const i = Number(h.dataset.stephead); stepOpen[i] = !stepOpen[i]; renderSteps(); });
    });

    function openChannels(title, text) {
      const mt = $('dr-modal-title'); if(mt) mt.textContent = title;
      const wa = $('dr-chan-wa'); if(wa) wa.href = 'https://wa.me/' + CONFIG.wa + '?text=' + encodeURIComponent(text);
      const tg = $('dr-chan-tg'); if(tg) tg.href = 'https://t.me/' + CONFIG.tg + '?text=' + encodeURIComponent(text);
      const mx = $('dr-chan-max'); if(mx) mx.href = CONFIG.max;
      const tl = $('dr-chan-tel'); if(tl) tl.href = 'tel:' + CONFIG.tel;
      const m = $('dr-modal'); if(m) m.hidden = false;
    }
    function closeChannels() { const m = $('dr-modal'); if(m) m.hidden = true; }
    bind('dr-modal-x', 'click', closeChannels);
    bind('dr-modal', 'click', (e) => { if (e.target === $('dr-modal')) closeChannels(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeChannels(); closeSheet(); } });

    bind('dr-toast-go', 'click', () => {
      const t = $('dr-toast'); if(t) t.hidden = true;
      const anchor = document.getElementById('zayavka');
      if (anchor) anchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    bind('dr-toast-stay', 'click', () => { const t = $('dr-toast'); if(t) t.hidden = true; });
    bind('dr-sheet-book', 'click', pick);

    window.addEventListener('drcalc-reset', doReset);
    window.addEventListener('drcalc-refresh', () => pick());
    bind('dr-reset', 'click', doReset);
  }

  function saveCalcState() {
    try {
      const data = {
        mode: state.mode, pack: state.pack, customBase: state.customBase,
        customYm: state.customYm, guests: state.guests, guestsTouched: state.guestsTouched,
        date: $('dr-date') ? $('dr-date').value : '', slot: state.slot || '',
        ext: state.extSel === undefined ? undefined : state.extSel,
        roomExt: $('dr-room-ext') ? $('dr-room-ext').checked : false,
        rh: document.querySelector('input[name="dr-rh"]:checked')?.value || '30',
        menu: $('dr-menu') ? $('dr-menu').checked : false, 
        video: $('dr-video') ? $('dr-video').checked : false,
        photo: $('dr-photo') ? $('dr-photo').checked : false, 
        balls: $('dr-balls') ? $('dr-balls').checked : false,
        tort: $('dr-tort') ? $('dr-tort').checked : false, 
        room2: $('dr-room2') ? $('dr-room2').checked : false,
        banquet: $('dr-banquet') ? $('dr-banquet').checked : false,
        packModified: state.packModified,
        snapshot: snapshot, dirty: dirty,
        sent: !!(window.DR_CALC && window.DR_CALC.sent)
      };
      localStorage.setItem(LS_KEY, JSON.stringify(data));
    } catch (e) {}
  }

  function restoreCalcState() {
    let d = null;
    try { d = JSON.parse(localStorage.getItem(LS_KEY) || 'null'); } catch (e) {}
    if (!d) return false;
    try {
      if (d.mode === 'custom') {
        state.mode = 'custom';
        state.customBase = TARIFFS[d.customBase] ? d.customBase : 'base';
        const cb = document.querySelector('input[name="dr-cbase"][value="' + state.customBase + '"]');
        if (cb) cb.checked = true;
      } else if (d.pack && TARIFFS[d.pack]) {
        state.mode = 'packs'; state.pack = d.pack;
        const pr = document.querySelector('input[name="dr-pack"][value="' + d.pack + '"]');
        if (pr) pr.checked = true;
      } else return false;

      if (typeof d.guests === 'number' && d.guests > 0) state.guests = d.guests;
      state.guestsTouched = !!d.guestsTouched;
      const di = $('dr-date'); if (d.date && di) di.value = d.date;
      if (d.slot) state.slot = d.slot;
      window.DR_CALC.sent = !!d.sent;

      if (d.mode === 'custom') {
        const cymEl = document.querySelector('input[name="dr-cym"][value="' + (d.customYm || '0') + '"]');
        if (cymEl) cymEl.checked = true;
        state.customYm = d.customYm || '0';
      }
      
      showSteps(true);
      syncProgramUI();

      if (d.snapshot) { snapshot = d.snapshot; dirty = !!d.dirty; prevDirty = dirty; }
      
      if (d.ext === null) state.extSel = null;
      else if (d.ext != null) state.extSel = parseInt(d.ext, 10);
      else state.extSel = undefined;
      
      state.packModified = false;

      const re = $('dr-room-ext'); if (d.roomExt && re) re.checked = true;
      const rh = document.querySelector('input[name="dr-rh"][value="' + (d.rh || '30') + '"]');
      if (rh) rh.checked = true;
      ['menu','video','photo','balls','tort','room2','banquet'].forEach((k) => {
        const el = $('dr-' + k); if (d[k] && el) el.checked = true;
      });

      recalcAll();

      const dot = $('dr-pill-dot'); if (dot) dot.hidden = !dirty;
      pushSnapshot();
      syncCart();
      showCart();
      return true;
    } catch (e) { return false; }
  }

  function buildSlots() {
    const box = $('dr-slots');
    const t = currentTariff();
    if (!box) return;
    if (!t) { box.innerHTML = ''; return; }
    const lastStart = CONFIG.endHour - slotHours();
    const labels = [];
    
    for (let h = CONFIG.startHour; h <= CONFIG.endHour; h++) {
      for (let m = 0; m < 60; m += 30) {
        const timeVal = h + m / 60;
        if (timeVal > lastStart) break;
        const hh = h < 10 ? '0' + h : h;
        const mm = m === 0 ? '00' : '30';
        labels.push(hh + ':' + mm);
      }
    }
    
    if (!labels.includes(state.slot)) state.slot = null;
    box.innerHTML = '';
    
    if (labels.length === 0) {
      box.innerHTML = '<span class="drc-hint" style="margin-top:0;">на эту дату свободных слотов мало — уточним по телефону</span>';
      return;
    }

    labels.forEach((label) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'drc-slot' + (label === state.slot ? ' is-active' : '');
      b.textContent = label;
      b.addEventListener('click', function () {
        if (state.slot === label) { state.slot = null; b.classList.remove('is-active'); }
        else { state.slot = label; box.querySelectorAll('.drc-slot').forEach((x) => x.classList.remove('is-active')); b.classList.add('is-active'); }
        calculate();
      });
      box.appendChild(b);
    });
  }

  function showSteps(show) {
    const s = $('dr-steps'); if(s) s.hidden = !show;
    if (!show) { 
      const sh = $('dr-sheet'); if(sh) sh.hidden = true; 
    }
  }

  function recalcAll() {
    syncProgramUI();
    syncExt(); syncVisibility(); syncGuests();
    buildSlots(); calculate(); syncCart(); showCart();
  }

  const stepOpen = [true, false, false, false, false];
  function renderSteps() {
    document.querySelectorAll('#dr-steps .drc-step').forEach((st, i) => {
      const body = st.querySelector('.drc-step__body');
      const head = st.querySelector('.drc-step__head');
      if (!body || !head) return;
      body.hidden = !stepOpen[i];
      head.classList.toggle('is-open', stepOpen[i]);
      head.setAttribute('aria-expanded', stepOpen[i] ? 'true' : 'false');
    });
  }
  
  function openNext(i) { if (i < 4 && !stepOpen[i + 1]) { stepOpen[i + 1] = true; renderSteps(); } }

  function setPack(val) {
    state.mode = 'packs';
    state.pack = val;
    document.querySelectorAll('input[name="dr-pack"]').forEach(r => { r.checked = (r.value === val); });
    document.querySelectorAll('input[name="dr-cbase"], input[name="dr-cym"]').forEach(r => r.checked = false);
    state.customBase = 'base';
    state.customYm = '0';
    const t = TARIFFS[val];
    if (!t) return;
    state.guests = state.guestsTouched ? Math.max(state.guests, t.minGuests) : t.minGuests;
    resetExtras();
    state.extSel = undefined;
    state.packModified = false;
    showSteps(true);
    syncProgramUI();
    recalcAll();
    const st = $('dr-steps'); if (st) st.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function setCustom(baseVal) {
    state.mode = 'custom';
    state.pack = null;
    document.querySelectorAll('input[name="dr-pack"]').forEach(r => r.checked = false);
    document.querySelectorAll('input[name="dr-cbase"]').forEach(r => { r.checked = (r.value === baseVal); });
    state.customBase = baseVal;
    const t = TARIFFS[baseVal];
    if (!t) return;
    state.guests = state.guestsTouched ? Math.max(state.guests, t.minGuests) : t.minGuests;
    showSteps(true);
    syncProgramUI();
    recalcAll();
  }

  function doReset() {
    try { localStorage.removeItem(LS_KEY); } catch (e) {}
    ['dr-menu','dr-video','dr-photo','dr-balls','dr-tort','dr-room2','dr-room-ext','dr-banquet'].forEach((id) => { const el = $(id); if(el) el.checked = false; });
    const rh = $('dr-room-hours'); if(rh) rh.hidden = true;
    document.querySelectorAll('input[name="dr-pack"], input[name="dr-cbase"], input[name="dr-cym"]').forEach((i) => (i.checked = false));
    const di = $('dr-date'); if(di) di.value = '';
    
    state.mode = 'packs'; state.pack = null;
    state.customBase = 'base'; state.customYm = '0';
    state.guests = 6; state.guestsTouched = false; state.slot = null;
    state.extSel = undefined; state.packModified = false;
    stepOpen[0] = true; stepOpen[1] = false; stepOpen[2] = false; stepOpen[3] = false; stepOpen[4] = false;
    snapshot = null; dirty = false; prevDirty = false;
    window.DR_CALC.justUpdatedAt = 0;
    window.DR_CALC.sent = false;
    
    syncProgramUI();
    syncCart(); showCart();
    showSteps(false);
    window.DR_CALC.ready = false;
    pushSnapshot();
    const c = document.querySelector('.drc__cards');
    if(c) c.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  bindEvents();
  restoreCalcState();
  renderSteps();
</script>