---
const { title = 'Кальмар — квесты в Ростове-на-Дону', description = 'Квесты для детей и взрослых в Ростове-на-Дону' } = Astro.props;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" href="/favicon.svg">
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a href="/" class="logo">XKALMAR</a>
      <nav>
        <a href="/" class="site-header__link">Главная</a>
        <a href="tel:+79287588483" class="site-header__phone">+7 (928) 758-84-83</a>
        <a href="#zayavka" class="site-header__cta">Забронировать</a>
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site-footer">
    <div class="wrap">
      <p>© 2026 XKALMAR — квесты в Ростове-на-Дону</p>
      <p><a href="/privacy" target="_blank" rel="noopener">Политика конфиденциальности</a></p>
    </div>
  </footer>
</body>
</html>

<style is:global>
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background: #032E2B;
  color: #ffffff;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}
.wrap { max-width: 1100px; margin: 0 auto; padding: 0 24px; width: 100%; }
main { flex: 1; }

.site-header {
  padding: 20px 0;
  border-bottom: 1px solid rgba(255,255,255,0.12);
}
.site-header .wrap { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
.logo { color: #ffffff; font-weight: 800; font-size: 22px; text-decoration: none; letter-spacing: 0.04em; }
.site-header nav { display: flex; gap: 24px; flex-wrap: wrap; }
.site-header nav a { color: rgba(255,255,255,0.75); text-decoration: none; font-size: 14px; }
.site-header nav a:hover { color: #ffffff; }

.site-footer {
  padding: 28px 0;
  border-top: 1px solid rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.55);
  font-size: 13px;
}
.site-footer .wrap { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
.site-footer a { color: rgba(255,255,255,0.75); }

.site-header__cta {
  background: #C30067;
  color: #fff !important;
  padding: 10px 22px;
  border-radius: 22px;
  font-weight: 700;
  font-size: 14px;
  text-decoration: none;
  transition: background .15s;
}
.site-header__cta:hover { background: #E00077; }

@media (max-width: 640px) {
  .site-header { padding: 12px 0; }
  .site-header nav { gap: 10px; align-items: center; }
  .site-header__link,
  .site-header__phone { display: none; }
  .logo { font-size: 18px; }
  .site-header__cta { padding: 9px 16px; font-size: 13px; }
}
</style>
