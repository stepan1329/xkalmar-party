---
import Base from '../layouts/Base.astro';
import Calculator from '../components/Calculator.astro';
import RequestForm from '../components/RequestForm.astro';
---
<Base title="XKALMAR — день рождения в квест-шоу | Ростов-на-Дону" description="День рождения в квест-шоу для детей в Ростове-на-Дону: сценарий, актёры, банкет под ключ, фото и торт. Рассчитайте праздник за минуту.">
  <section class="hero">
    <div class="hero__bg">
      <img src="/photos/hero-1.webp" alt="Квест-шоу Игра в кальмара для детей — праздник под ключ в Ростове-на-Дону" class="hero__img hero__img--desktop" />
      <img src="/photos/hero-mobil-1.webp" alt="Детский квест-шоу в Ростове-на-Дону — яркие эмоции для детей 6–12 лет" class="hero__img hero__img--mobile" />
    </div>
    <span class="hero__tag">Квест-шоу для детей · Ростов-на-Дону</span>
    <h1>Дети — в квест-шоу.<br />Родители — <em>отдыхают</em>.</h1>
    <p>Мы берём праздник на себя полностью: сценарий, актёры, сервировка, торт, фото. Вам остаётся только прийти и дождаться восторженных детей.</p>
    <a href="#calc">Рассчитать праздник</a>
  </section>

  <Calculator />

  <!-- TIMELINE -->
  <section class="timeline" id="timeline">
    <div class="wrap">
      <h2>Из чего состоит праздник</h2>
      <p class="timeline__sub">Формат один, набор блоков — по выбранному пакету. Длительность и порядок подстроим под вас при брони.</p>
      <div class="timeline__list">
        <div class="timeline__item">
          <span class="timeline__num">1</span>
          <div>
            <b>Сборы и инструктаж</b>
            <p>Дети надевают игровые футболки с номерами и знакомятся с ведущими. Родители ждут в зоне ожидания с кофе.</p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__num">2</span>
          <div>
            <b>Квест-шоу</b>
            <p>Эстафеты, логика, внимание и память. Новое испытание каждые 8–10 минут — никто не выбывает и не скучает. Каждый участник получает сувенир.</p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__num">3</span>
          <div>
            <b>Поздравление и вынос торта</b>
            <p>Свечи, именинник в центре — самые живые кадры праздника.</p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__num">4</span>
          <div>
            <b>Банкет</b>
            <p>Сервированная банкетная комната. Своя еда или под ключ — как в выбранном пакете.</p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__num">5</span>
          <div>
            <b>Ярмарка игр</b>
            <p>Трое ведущих играют одновременно: стена-кидалка, мафия, вышибалы, «нащупай предмет», «угадай напиток». Каждый ребёнок выбирает своё — без очередей.</p>
          </div>
        </div>
        <div class="timeline__item">
          <span class="timeline__num">6</span>
          <div>
            <b>Чай с тортом и сборы</b>
            <p>Организатор нарезает торт, дети пьют чай — праздник завершён.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ЯРМАРКА ИГР -->
  <section class="yamarka" id="yamarka">
    <div class="wrap">
      <h2>Ярмарка игр</h2>
      <p class="yamarka__sub">После квеста трое ведущих одновременно проводят разные активности — и каждый ребёнок выбирает, что ему по душе.</p>
      <div class="yamarka__content">
        <div class="yamarka__text">
          <div class="yamarka__list">
            <div class="yamarka__row">
              <span class="yamarka__icon">🎯</span>
              <div>
                <b>Вышибалы впятером</b>
                <p>Командная игра на реакцию и координацию. Кто последний остался — победил!</p>
              </div>
            </div>
            <div class="yamarka__row">
              <span class="yamarka__icon">🥤</span>
              <div>
                <b>Угадай напиток</b>
                <p>Вслепую определяешь вкус — от газировки до сока. Сложнее, чем кажется!</p>
              </div>
            </div>
            <div class="yamarka__row">
              <span class="yamarka__icon">📦</span>
              <div>
                <b>Нащупай предмет</b>
                <p>В ящике спрятан предмет — угадай на ощупь. Руки обману не обманут!</p>
              </div>
            </div>
            <div class="yamarka__row">
              <span class="yamarka__icon">🃏</span>
              <div>
                <b>Мафия</b>
                <p>Стратегическая игра на логику и наблюдательность. Ведущий ведёт партию.</p>
              </div>
            </div>
            <div class="yamarka__row">
              <span class="yamarka__icon">🧱</span>
              <div>
                <b>Стена-кидалка</b>
                <p>Проектор на стене — лови мяч, уклоняйся, реагируй. Движение без пауз.</p>
              </div>
            </div>
          </div>
          <p class="yamarka__note">Никто не стоит в очереди. Никто не ждёт своей команды. Каждый занят тем, что ему нравится.</p>
        </div>
        <div class="yamarka__video">
          <iframe src="https://kinescope.io/embed/sNbVwwHesgoeMfyGbU2GCG" allow="autoplay; fullscreen" allowfullscreen title="Ярмарка игр — квест-шоу Игра в кальмара"></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ПЛОЩАДКА -->
  <section class="hallway" id="hallway">
    <div class="wrap">
      <h2>Площадка 240 м²</h2>
      <p class="hallway__sub">Своя территория под квест-шоу — не арендуем чужую площадку на час.</p>
      <div class="hallway__content">
        <div class="hallway__text">
          <p>Игровая и банкетная комнаты — под одной крышей, отдельный вход, вентиляция. Звук, свет, видеоряд — всё своё, всё настроено под квест-шоу. Вам не нужно переезжать из комнаты в комнату через чужой коридор.</p>
          <p><b>Родители могут остаться</b></p>
          <p>Смотрите игру из игровой комнаты, посидите в банкетной, уходите и возвращайтесь — как вам удобно. Мы не выгоняем родителей и не заставляем их сидеть в коридоре. Вы участвуете в празднике ровно настолько, насколько хотите.</p>
        </div>
        <div class="hallway__video">
          <iframe src="https://kinescope.io/embed/3QTCvnzrXbWFQxz3RHX3Gf" allow="autoplay; fullscreen" allowfullscreen title="Обзор площадки — квест-шоу Игра в кальмара Ростов-на-Дону"></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="features">
    <div class="wrap">
      <h2>Почему мы</h2>
      <div class="features__grid">
        <div class="feature-card">
          <b>Это не квест-комната, а шоу</b>
          <p>Дети не разгадывают загадки в закрытом помещении — двигаются, бегают, соревнуются. 90 минут без пауз и скуки.</p>
        </div>
        <div class="feature-card">
          <b>Трое ведущих на каждом празднике</b>
          <p>Не один человек на группу, а команда: каждый ведущий держит свой участок — никто не остаётся без внимания.</p>
        </div>
        <div class="feature-card">
          <b>Девять игр за 90 минут</b>
          <p>Каждые 8–10 минут — новое испытание. Дети не успевают устать ни заскучать: темп держит игра, а не ведущий.</p>
        </div>
        <div class="feature-card">
          <b>Никто не выбывает и не обижается</b>
          <p>Без проигравших и вылетевших — все играют до финала. Застенчивым помогаем, активным направляем, младшим облегчаем, старшим усложняем.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <div class="wrap">
      <h2>Частые вопросы</h2>
      <div class="faq__list">
        <details class="faq__item">
          <summary>Это же Игра в кальмара — это страшно?</summary>
          <p>Нет. От сериала мы взяли только игры и реквизит — всё адаптировано под детей. Это не хоррор, а увлекательное квест-шоу с актёрами, где в центре внимания именинник. Малыши играют наравне со старшими, а родители видят весь процесс.</p>
        </details>
        <details class="faq__item">
          <summary>Почему у вас дороже обычных квестов?</summary>
          <p>В обычном квесте ребёнка встречают оператор и один актёр. У нас на празднике работает команда из 5 человек, и каждый занят: ведут игру, накрывают стол, снимают видео. Это формат «под ключ», а не час в закрытой комнате.</p>
        </details>
        <details class="faq__item">
          <summary>С какого возраста? Будет ли интересно 6-летним? А 12-летним?</summary>
          <p>Наша специализация — 6–12 лет, сценарий адаптируется: младшим играем мягче и проще, старшим добавляем логику и командные задания. Младших (от 4 лет) берём, если они пришли вместе с братом или сестрой — играют вместе со всеми.</p>
        </details>
        <details class="faq__item">
          <summary>Где вы находитесь?</summary>
          <p>Ростов-на-Дону, ул. Зорге, 15. Только эта площадка — выезда нет. Рядом «Магнит», «Пятёрочка», рынок «Привоз» и ТЦ «Талер» с пиццей и кафе. Площадка 240 кв. м: отдельная игровая комната и две банкетные, не связанные друг с другом — детей и взрослых можно рассадить раздельно. Во всех комнатах принудительная вентиляция и сплит-системы. Для торта и напитков — холодильник, есть микроволновка и питьевая вода.</p>
        </details>
        <details class="faq__item">
          <summary>Что с собой везти?</summary>
          <p>Зависит от пакета. В «Популярном», «Базе» и «Мини» еду приносите свою — стол накрываем мы: сервировка, скатерть, чай/кофе, печенье, нож для торта и контейнеры, чтобы увезти торт с собой. В «Оптимальном» стол под ключ: пицца, наггетсы, картошка фри, соки, порционный торт каждому. В «Максимальном» — то же меню под ключ и большой торт от кондитера. Принести своё сверх пакета можно всегда — хоть еду, хоть торт, ограничений нет.</p>
        </details>
        <details class="faq__item">
          <summary>Как забронировать и сколько ждать?</summary>
          <p>Оставьте заявку на сайте или позвоните — организатор Лена перезвонит в течение часа. Разговор 20 минут: расскажем, как проходит праздник, ответим на вопросы. Дальше — предоплата 3 000 ₽ (возвращается в любой день, кроме дня праздника), и время ваше. Можно просто «подумать» — без давления.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="reviews">
    <div class="wrap">
      <h2>Отзывы</h2>
      <p class="reviews__sub">Рейтинг 5.0 на Яндекс Картах — по 154 оценкам · <a href="https://yandex.ru/maps/org/kvest_shou_igra_v_kalmara/19338708863/reviews/" target="_blank" rel="noopener">Читать все отзывы</a></p>
      <div class="reviews__grid">
        <div class="review-card">
          <p>Огромное спасибо за невероятно крутой квест «Игра в кальмара»! Детям всё очень понравилось, они остались в полном восторге! Столько эмоций, азарта, веселья и незабываемых впечатлений! Всё было организовано на высшем уровне, ребята получили массу положительных эмоций и ещё долго делились своими впечатлениями. Спасибо организаторам за чудесный праздник, отличную атмосферу и подаренные детям счастливые моменты! Обязательно будем рекомендовать вас друзьям и с удовольствием придём ещё раз!</p>
          <span class="review-card__name">Таня Косякова</span>
        </div>
        <div class="review-card">
          <p>Праздновали день рождения сына. Остались довольны все и дети и родители. Потрясающая администратор, заняла детей несмотря на то что мы раньше пришли, всегда интересовалась нужно ли нам что-то. Ведущие без внимания ни одного ребенка не отставили. В интерьере продумано все до мелочей. Сын сказал в следующем году пойдем сюда снова. Тем более что у ребят меняется программа.</p>
          <span class="review-card__name">Екатерина Щ.</span>
        </div>
        <div class="review-card">
          <p>Очень крутое место, чтобы отметить день рождения ребенка! Атмосферно, две банкетных комнаты, большая стилизованная игровая! Актеры и администратор Елена — супер, очень приятные и отзывчивые. Детям очень понравилась игра! Спасибо</p>
          <span class="review-card__name">Таня А.</span>
        </div>
        <div class="review-card">
          <p>Отмечали день рождения ребенку 6.09. Хочу сказать спасибо организаторам. Все было на высшем уровне. Дети в восторге. Помещение очень чистое. Персонал приветливый. С удовольствием провели время. Если думаете где отметить день рождения ребенка, однозначно выбирайте этот квест.</p>
          <span class="review-card__name">Михаил К.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ГАЛЕРЕЯ -->
  <section class="gallery" id="gallery">
    <div class="wrap">
      <h2>Фотогалерея</h2>
      <p class="gallery__sub">Реальные моменты с наших праздников — нажми, чтобы рассмотреть</p>
      <div class="gallery__grid">
        <button class="gallery__item" data-src="/photos/squid-game-quest-1.webp" data-alt="Квест-шоу Игра в кальмара — дети в игровых футболках с номерами">
          <img src="/photos/squid-game-quest-1.webp" alt="Квест-шоу для детей — дети в футболках с номерами" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-2.webp" data-alt="Эстафеты на квест-шоу — активные игры для детей 6–12 лет">
          <img src="/photos/squid-game-quest-2.webp" alt="Эстафеты на квест-шоу для детей" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-3.webp" data-alt="Командные игры на квесте — логика и внимание">
          <img src="/photos/squid-game-quest-3.webp" alt="Командные игры на квесте" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-4.webp" data-alt="Вышибалы на ярмарке игр — активная игра для детей">
          <img src="/photos/squid-game-quest-4.webp" alt="Вышибалы на ярмарке игр" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-5.webp" data-alt="Угадай напиток — игра на ярмарке для детей">
          <img src="/photos/squid-game-quest-5.webp" alt="Игра Угадай напиток на ярмарке" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-6.webp" data-alt="Мафия с ведущим — стратегическая игра для детей">
          <img src="/photos/squid-game-quest-6.webp" alt="Мафия с ведущим на квесте" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-7.webp" data-alt="Стена-кидалка — интерактивная игра на проекторе">
          <img src="/photos/squid-game-quest-7.webp" alt="Стена-кидалка на квест-шоу" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-8.webp" data-alt="Нащупай предмет — игра вслепую на ярмарке">
          <img src="/photos/squid-game-quest-8.webp" alt="Нащупай предмет на ярмарке игр" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-9.webp" data-alt="Поздравление именинника — вынос торта на квесте">
          <img src="/photos/squid-game-quest-9.webp" alt="Поздравление и вынос торта на квесте" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-10.webp" data-alt="Торт на празднике — свечи и именинник в центре">
          <img src="/photos/squid-game-quest-10.webp" alt="Вынос торта на детском празднике" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-11.webp" data-alt="Банкетная комната — сервировка стола на квесте">
          <img src="/photos/squid-game-quest-11.webp" alt="Банкетная комната на квесте" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-12.webp" data-alt="Дети за банкетным столом — праздник под ключ">
          <img src="/photos/squid-game-quest-12.webp" alt="Дети за банкетным столом" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-13.webp" data-alt="Ведущие-актёры с детьми — квест-шоу для детей 6–12 лет">
          <img src="/photos/squid-game-quest-13.webp" alt="Ведущие-актёры с детьми на квесте" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-14.webp" data-alt="Родители наблюдают за праздником — зона ожидания">
          <img src="/photos/squid-game-quest-14.webp" alt="Родители наблюдают за квестом" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-15.webp" data-alt="Сувениры каждому ребёнку — памятные подарки на квесте">
          <img src="/photos/squid-game-quest-15.webp" alt="Сувениры каждому ребёнку на квесте" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-16.webp" data-alt="Финал квест-шоу — все дети вместе">
          <img src="/photos/squid-game-quest-16.webp" alt="Финал квест-шоу — все участники вместе" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-17.webp" data-alt="Игровая комната — пространство 240 м² для квеста">
          <img src="/photos/squid-game-quest-17.webp" alt="Игровая комната на квесте" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-18.webp" data-alt="Ведущие проводят игру — квест-шоу для детей">
          <img src="/photos/squid-game-quest-18.webp" alt="Ведущие проводят квест-шоу" loading="lazy" />
        </button>
        <button class="gallery__item" data-src="/photos/squid-game-quest-19.webp" data-alt="Дети выполняют задания — логика и скорость">
          <img src="/photos/squid-game-quest-19.webp" alt="Дети выполняют задания на квесте" loading="lazy" />
