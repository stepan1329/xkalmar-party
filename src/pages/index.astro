    const digits = (v) => (String(v).match(/\d/g) || []).length;

    /* ---------- Общая отправка лидов ---------- */
    const FORM_URL = 'https://script.google.com/macros/s/AKfycbwvgQ0INRJRzT4xu5mQ6ht_SakiUL7kEIBqDw-a88ooyfapllfD3Yr1undNexLI2KaP/exec';
    const WA_NUMBER = '79287588483';

    async function sendLead(payload) {
      try {
        const res = await fetch(FORM_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload)
        });
        const data = await res.json().catch(() => null);
        return res.ok && (!data || data.ok !== false);
      } catch (e) {
        return false;
      }
    }

    function waLink(text) {
      return 'https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(text);
    }

    /* ---------- Квиз: 4 шага ---------- */
    const quiz = $('#quiz');
    if (quiz) {
      const steps = $$('.q-step', quiz);
      const bar = $('#q-bar');
      const stepnum = $('#q-stepnum');
      const back = $('#q-back');
      const next = $('#q-next');
      const done = $('#q-done');
      const form = $('#q-form');
      let cur = 0;

      const noDate = $('#q-nodate');
      const dateInput = $('#q-date');
      noDate.addEventListener('change', () => {
        dateInput.disabled = noDate.checked;
        if (noDate.checked) markField(dateInput, false);
      });

      function markField(input, bad) {
        const field = input.closest('.field') || input.closest('.q-group');
        if (!field) return;
        input.setAttribute('aria-invalid', bad ? 'true' : 'false');
        const err = $('.f-err', field);
        if (err) err.hidden = !bad;
      }
      function markGroup(group, bad) {
        group.classList.toggle('is-error', bad);
        const err = $('.f-err', group);
        if (err) err.hidden = !bad;
      }

      function stepValid(n) {
        const step = steps[n];
        let ok = true;
        if (n === 0) {
          const bad = !dateInput.value && !noDate.checked;
          markField(dateInput, bad);
          ok = !bad;
        } else if (n === 1) {
          $$('[data-group]', step).forEach((g) => {
            const bad = !$('input:checked', g);
            markGroup(g, bad);
            if (bad) ok = false;
          });
        } else if (n === 2) {
          const g = $('[data-group]', step);
          const bad = !$('input:checked', g);
          markGroup(g, bad);
          ok = !bad;
        } else {
          const name = $('#q-name');
          const phone = $('#q-phone');
          const consent = $('#q-consent');
          const badName = name.value.trim().length < 2;
          const badPhone = digits(phone.value) < 10;
          markField(name, badName);
          markField(phone, badPhone);
          const consentErr = $('#q-consent').closest('label').nextElementSibling;
          if (consentErr) consentErr.hidden = consent.checked;
          if (badName || badPhone || !consent.checked) ok = false;
        }
        return ok;
      }

      function show(n) {
        cur = n;
        steps.forEach((s, k) => (s.hidden = k !== n));
        stepnum.textContent = 'Шаг ' + (n + 1) + ' из ' + steps.length;
        bar.style.width = (n / (steps.length - 1)) * 100 + '%';
        back.hidden = n === 0;
        next.textContent = n === steps.length - 1 ? 'Отправить' : 'Далее';
        const h = $('h3', steps[n]);
        if (h) h.focus({ preventScroll: true });
      }

      async function submitQuizLead(rec) {
        const name = $('#q-name').value.trim();
        const phone = $('#q-phone').value.trim();
        const dateKnown = $('#q-nodate').checked ? '' : $('#q-date').value || '';
        const occasion = ($('input[name="q2-occasion"]:checked', quiz) || {}).value || '';
        const age = ($('input[name="q2-age"]:checked', quiz) || {}).value || '';
        const guests = ($('input[name="q3"]:checked', quiz) || {}).value || '';
        const text = [
          '🔔 ЗАЯВКА С КВИЗА (xkalmar.com)',
          'Имя: ' + (name || 'не указано'),
          'Телефон: ' + (phone || 'не указан'),
          'Дата праздника: ' + (dateKnown || 'пока не известна'),
          'Повод: ' + (occasion || 'не указан'),
          'Возраст детей: ' + (age || 'не указан'),
          'Гостей: ' + (guests || 'не указано'),
          'Подходящий пакет: ' + rec
        ].join('\n');
        const ok = await sendLead({ name, phone, partyDate: dateKnown, summary: rec, text });
        if (!ok) {
          const alt = $('.quiz__done-alt', quiz);
          if (alt && !$('.quiz__fallback', quiz)) {
            alt.insertAdjacentHTML('beforebegin',
              '<p class="quiz__done-alt">Не отправилось автоматически? <a href="' + waLink(text) + '" target="_blank" rel="noopener">Продублируйте заявку в WhatsApp</a></p>');
          }
        }
      }

      next.addEventListener('click', () => {
        if (!stepValid(cur)) return;
        if (cur === steps.length - 1) {
          const g = ($('input[name="q3"]:checked', quiz) || {}).value || '';
          let rec = '«Популярный» — 24 000 ₽';
          if (g === 'до 8') rec = '«Мини» — 15 000 ₽ или «Популярный» — 24 000 ₽';
          else if (g === 'больше 15')
            rec = '«Популярный» — 24 000 ₽ или «Максимальный» — 50 000 ₽ (за каждого гостя сверх 15 — +1 000 ₽)';
          $('#q-rec').textContent =
            'Похоже, вам подойдёт ' + rec + '. Точный состав организатор подтвердит по телефону — перезвоним в течение часа.';
          form.hidden = true;
          $('.quiz__nav', quiz).hidden = true;
          done.hidden = false;
          submitQuizLead(rec);
        } else {
          show(cur + 1);
        }
      });
      back.addEventListener('click', () => show(Math.max(0, cur - 1)));

      // Ошибки снимаются при исправлении
      $$('input, select', quiz).forEach((el) => {
        el.addEventListener('input', () => {
          if (el.type === 'radio' || el.type === 'checkbox') {
            const g = el.closest('.q-group');
            if (g) markGroup(g, false);
            if (el.id === 'q-consent') {
              const e = el.closest('label').nextElementSibling;
              if (e) e.hidden = true;
            }
          } else {
            markField(el, false);
          }
        });
      });
      show(0);
    }

    /* ---------- Форма заявки ---------- */
    const fform = $('#f-form');
    if (fform) {
      const name = $('#f-name');
      const phone = $('#f-phone');
      const consent = $('#f-consent');
      const consentErr = $('#f-consent-err');
      const mark = (input, bad) => {
        input.setAttribute('aria-invalid', bad ? 'true' : 'false');
        const err = input.closest('.field')?.querySelector('.f-err');
        if (err) err.hidden = !bad;
      };
      fform.addEventListener('submit', async (e) => {
        e.preventDefault();
        const badName = name.value.trim().length < 2;
        const badPhone = digits(phone.value) < 10;
        mark(name, badName);
        mark(phone, badPhone);
        consentErr.hidden = consent.checked;
        if (badName || badPhone || !consent.checked) return;
        fform.hidden = true;
        $('#f-done').hidden = false;

        const date = $('#f-date').value || '';
        const guestsSel = $('#f-guests');
        const packageSel = $('#f-package');
        const comment = $('#f-comment').value.trim();
        const text = [
          '🔔 ЗАЯВКА С ФОРМЫ (xkalmar.com)',
          'Имя: ' + name.value.trim(),
          'Телефон: ' + phone.value.trim(),
          'Дата праздника: ' + (date || 'пока не известна'),
          'Гостей: ' + (guestsSel.value || 'не указано'),
          'Пакет: ' + (packageSel.value || 'подберём по телефону'),
          comment ? 'Комментарий: ' + comment : '',
          '— — —',
          'Источник: главная, без расчёта из калькулятора'
        ].filter((l) => l !== '').join('\n');
        const ok = await sendLead({
          name: name.value.trim(),
          phone: phone.value.trim(),
          partyDate: date,
          summary: packageSel.value ? 'Пакет: ' + packageSel.value : '',
          text
        });
        if (!ok) {
          const fallback = $('#f-done p');
          if (fallback && !$('#f-done .quiz__fallback')) {
            fallback.insertAdjacentHTML('afterend',
              '<p class="quiz__fallback"><a href="' + waLink(text) + '" target="_blank" rel="noopener">Продублируйте заявку в WhatsApp</a></p>');
          }
        }
      });
      [name, phone].forEach((el) => el.addEventListener('input', () => mark(el, false)));
      consent.addEventListener('change', () => (consentErr.hidden = true));
    }

    /* ---------- «Выбрать пакет» → предзаполнение формы ---------- */
    $$('.pack__cta').forEach((btn) => {
      btn.addEventListener('click', () => {
        const sel = $('#f-package');
        if (sel) {
          sel.value = btn.dataset.package;
          sel.classList.add('is-flash');
          setTimeout(() => sel.classList.remove('is-flash'), 1200);
        }
        $('#zayavka').scrollIntoView({ behavior: 'smooth', block: 'start' });
        const name = $('#f-name');
        if (name) name.focus({ preventScroll: true });
      });
    });

    /* ---------- Sticky-панель на мобильных ---------- */
    const bar = $('#stickybar');
    const heroCta = $('#hero-cta');
    const formSec = $('#zayavka');
    if (bar && 'IntersectionObserver' in window && heroCta && formSec) {
      let heroVisible = true;
      let formVisible = false;
      const update = () => bar.classList.toggle('is-hidden', heroVisible || formVisible);
      new IntersectionObserver((entries) => {
        heroVisible = entries[0].isIntersecting;
        update();
      }).observe(heroCta);
      new IntersectionObserver((entries) => {
        formVisible = entries[0].isIntersecting;
        update();
      }).observe(formSec);
    }

    /* ---------- Минимальная дата — сегодня ---------- */
    $$('input[type="date"]').forEach((i) => {
      i.min = new Date().toISOString().slice(0, 10);
    });
  </script>
</body>
</html>

