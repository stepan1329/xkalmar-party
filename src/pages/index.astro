  <script>
    // @ts-nocheck
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    let currentIndex = 0;

    // Живая выборка: превью добавляются пагинацией по клику.
    function photoItems() {
      return Array.from(document.querySelectorAll('#media-thumbs .gallery__item[data-src]'));
    }

    function openLightbox(index) {
      const items = photoItems();
      if (!items.length) return;
      currentIndex = (index + items.length) % items.length;
      const item = items[currentIndex];
      lightboxImg.src = item.dataset.src;
      lightboxImg.alt = item.dataset.alt;
      lightbox.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    document.getElementById('lightbox-close').addEventListener('click', closeLightbox);
    document.getElementById('lightbox-prev').addEventListener('click', () => openLightbox(currentIndex - 1));
    document.getElementById('lightbox-next').addEventListener('click', () => openLightbox(currentIndex + 1));

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') navigate(-1);
      if (e.key === 'ArrowRight') navigate(1);
    });
  </script>

  <script>
    // @ts-nocheck
    // МЕДИА-БЛОК: большой просмотрщик + превью (паттерн Мир Квестов).
    const mainBtn = document.getElementById('media-main');
    const mainImg = document.getElementById('media-main-img');
    const playBadge = document.getElementById('media-play');
    const playLabel = document.getElementById('media-play-label');
    const thumbsGrid = document.getElementById('media-thumbs');
    const hiddenGallery = document.getElementById('gallery-full');
    const moreBtn = document.getElementById('gallery-more');
    const PORTION = 12;

    // Клик по превью активирует большое окно.
    function activate(item) {
      document.querySelectorAll('#media-thumbs .is-active').forEach((el) => el.classList.remove('is-active'));
      item.classList.add('is-active');
      if (item.dataset.video) {
        mainBtn.dataset.type = 'video';
        mainBtn.dataset.video = item.dataset.video;
        mainImg.style.display = 'none';
        playLabel.textContent = item.dataset.title || 'Смотреть видео';
        playBadge.style.display = 'flex';
      } else {
        mainBtn.dataset.type = 'photo';
        delete mainBtn.dataset.video;
        mainImg.src = item.dataset.src;
        mainImg.alt = item.dataset.alt;
        mainImg.style.display = 'block';
        playBadge.style.display = 'none';
        currentIndex = photoItems().indexOf(item);
      }
    }

    document.addEventListener('click', (e) => {
      const item = e.target.closest('#media-thumbs .gallery__item');
      if (item) activate(item);
    });

    mainBtn.addEventListener('click', () => {
      if (mainBtn.dataset.type === 'video') {
        openVideoModal(mainBtn.dataset.video);
      } else {
        openLightbox(currentIndex);
      }
    });

    // Стартовое состояние — первое фото активно.
    const firstThumb = thumbsGrid.querySelector('.gallery__item[data-src]');
    if (firstThumb) firstThumb.classList.add('is-active');

    // Пагинация: фото из скрытой полной галереи добавляются в превью по 12.
    const hiddenItems = hiddenGallery
      ? Array.from(hiddenGallery.querySelectorAll('.gallery__item'))
      : [];
    const firstVideoThumb = thumbsGrid.querySelector('.media-thumb--video');
    let shownCount = photoItems().length;

    moreBtn.addEventListener('click', () => {
      const portion = hiddenItems.slice(shownCount, shownCount + PORTION);
      portion.forEach((item) => {
        const clone = item.cloneNode(true);
        if (firstVideoThumb) thumbsGrid.insertBefore(clone, firstVideoThumb);
        else thumbsGrid.appendChild(clone);
      });
      shownCount += portion.length;
      if (shownCount >= hiddenItems.length) {
        moreBtn.style.display = 'none';
      }
    });
  </script>

  <script>
    // @ts-nocheck
    const videoModal = document.getElementById('video-modal');
    const videoIframe = videoModal.querySelector('iframe');

    function openVideoModal(url) {
      videoIframe.src = url;
      videoModal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeVideoModal() {
      videoModal.classList.remove('is-open');
      videoIframe.src = '';
      document.body.style.overflow = '';
    }

    // Видео открывается кликом по большому окну медиа-блока (script выше).

    document.getElementById('video-modal-close').addEventListener('click', closeVideoModal);
    videoModal.addEventListener('click', (e) => {
      if (e.target === videoModal) closeVideoModal();
    });

    document.addEventListener('keydown', (e) => {
      if (!videoModal.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeVideoModal();
    });
  </script>

