</Concept>

<style is:global>
  :root {
    --bg: #120A2A;
    --bg-alt: #1B0F3B;
    --surface: #241452;
    --surface-2: #2E1A66;
    --text: #F3EEFF;
    --text-2: rgba(243, 238, 255, .72);
    --text-3: rgba(243, 238, 255, .45);
    --accent: #00E5FF;
    --cta: #FF2D9B;
    --cta-hover: #FF54AE;
    --on-cta: #FFFFFF;
    --line: rgba(255, 255, 255, .14);
    --star: #FFD166;
    --wrap: 1160px;
    --r: 12px;
    --r-l: 20px;
  }
  body { background: var(--bg); color: var(--text); }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 24px; width: 100%; }
  .wrap--narrow { max-width: 820px; }
  [id] { scroll-margin-top: 84px; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 13px 24px; border-radius: var(--r); border: 1px solid transparent;
    font-weight: 800; font-size: 15px; text-decoration: none; cursor: pointer;
    transition: background .15s ease, color .15s ease, border-color .15s ease, transform .15s ease, box-shadow .15s ease;
  }
  .btn--cta { background: var(--cta); color: var(--on-cta); box-shadow: 0 0 24px rgba(255,45,155,.45); }
  .btn--cta:hover { background: var(--cta-hover); }
  .btn--cta:active { transform: scale(.98); }
  .btn--outline { border-color: var(--line); color: var(--text); background: transparent; }
  .btn--outline:hover { border-color: var(--accent); color: var(--accent); }
  .btn--ghost { color: var(--text-2); border-color: var(--line); }
  .btn--ghost:hover { color: var(--text); border-color: var(--accent); }
  .btn--lg { padding: 16px 30px; font-size: 16px; }
