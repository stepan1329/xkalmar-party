// Концепт C «Реалити-игра»: стиль шоу-реалити — неон, игровая механика на виду: карточки игр, таймлайн как «раунды», отзывы как «результаты участников».
import Concept from '../../layouts/Concept.astro';

const TEL = '+79287588483';
const TEL_VIEW = '+7 (928) 758-84-83';
const WA = 'https://wa.me/79287588483';
const TG = 'https://t.me/xkalmar';
