---
// @ts-nocheck
// Концепт A «Шоу-перформанс»: кинематографичная афиша квест-шоу — тёмный зал, прожектор на имениннике, крупная типографика, острый контраст.
import Concept from '../../layouts/Concept.astro';

const TEL = '+79287588483';
const TEL_VIEW = '+7 (928) 758-84-83';
const WA = 'https://wa.me/79287588483';
const TG = 'https://t.me/xkalmar';
const MAX = 'https://max.ru/u/f9LHodD0cOKVRRd0t2pjN2pm8s7nWCNllQJYsSra5mx0QiqcfNxI553bSzc';
const MAPS = 'https://yandex.ru/maps/?text=%D0%A0%D0%BE%D1%81%D1%82%D0%BE%D0%B2-%D0%BD%D0%B0-%D0%94%D0%BE%D0%BD%D1%83%2C%20%D1%83%D0%BB%D0%B8%D1%86%D0%B0%20%D0%97%D0%BE%D1%80%D0%B3%D0%B5%2C%2015';
const REVIEWS = 'https://yandex.ru/maps/org/kvest_shou_igra_v_kalmara/19338708863/reviews/';
---
<Concept title="XKALMAR — концепт A «Шоу-перформанс»" description="Концепт главной XKALMAR: кинематографичная афиша квест-шоу для детей 6–12 лет.">
  <header class="hdr">
    <div class="wrap hdr__in">
      <a href="#top" class="logo">XKALMAR</a>
      <nav class="hdr__nav" aria-label="Разделы">
        <a href="#packages">Цены</a>
        <a href="#program">Программа</a>
        <a href="#venue">Площадка</a>
        <a href="#reviews">Отзывы</a>
        <a href="#faq">Вопросы</a>
      </nav>
      <div class="hdr__right">
        <a href={`tel:${TEL}`} class="hdr__phone">{TEL_VIEW}</a>
        <a href="#zayavka" class="btn btn--cta hdr__cta">Оставить заявку</a>
      </div>
    </div>
  </header>

  <main>
    <!-- 1. ПЕРВЫЙ ЭКРАН: оффер + цена + CTA -->
    <section class="hero" id="top">
      <div class="hero__media">
        <img src="/photos/hero-1.webp" alt="Дети проходят испытание на светящемся мосту, рядом ведущие-актёры в костюмах" fetchpriority="high" />
        <div class="hero__scrim"></div>
      </div>
      <div class="wrap hero__in">
        <p class="kicker">Квест-шоу · Ростов-на-Дону · Зорге, 15</p>
        <h1>Праздник,<br />с которого дети<br /><em>не хотят уходить</em></h1>
        <p class="hero__lead">Квест-шоу по мотивам «Игры в кальмара» для детей 6–12 лет. Не хоррор — увлекательное шоу с командой из 3 ведущих-актёров. В центре внимания — именинник.</p>
        <ul class="hero__meta">
          <li>6–12 лет</li>
          <li>1–1,5 ч квест-шоу</li>
          <li>от 15 000 ₽</li>
        </ul>
        <div class="hero__actions">
          <a href="#zayavka" class="btn btn--cta btn--lg">Оставить заявку</a>
          <a href="#trust" class="btn btn--ghost btn--lg">Смотреть фото</a>
        </div>
        <p class="hero__price">Пакеты: <b>Мини 15 000 ₽</b> · <b>Популярный 24 000 ₽</b> · <b>Максимальный 50 000 ₽</b></p>
        <p class="hero__trust"><span class="stars" aria-hidden="true">★★★★★</span> 5.0 на <a href={REVIEWS} target="_blank" rel="noopener">Яндекс.Картах</a></p>
      </div>
    </section>

    <!-- 2. ДОВЕРИЕ -->
    <section class="sec sec--alt" id="trust">
      <div class="wrap">
        <p class="frame">Кадр 01 — Доверие</p>
        <h2>Нам доверяют праздники</h2>
        <div class="trust">
          <div class="trust__facts">
            <div class="fact"><b>5.0</b><span>рейтинг на Яндекс.Картах</span></div>
            <div class="fact"><b>3</b><span>ведущих-актёра в команде</span></div>
            <div class="fact"><b>6–12</b><span>лет — наша специализация</span></div>
            <div class="fact"><b>Зорге, 15</b><span>своя площадка, отдельный вход</span></div>
          </div>
          <div class="trust__gallery">
            <img src="/photos/squid-game-quest-1.webp" alt="Девочка проходит испытание на светящемся мосту, рядом ведущие" loading="lazy" />
            <img src="/photos/squid-game-quest-9.webp" alt="Дети подсказывают участнику на испытании, ведущий рядом" loading="lazy" />
            <img src="/photos/squid-game-quest-49.webp" alt="Ведущие выносят торт имениннику" loading="lazy" />
            <img src="/photos/squid-game-quest-2.webp" alt="Участница на светящемся мосту, ведущие и дети вокруг" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- 3. ПАКЕТЫ И ЦЕНЫ -->
    <section class="sec" id="packages">
      <div class="wrap">
        <p class="frame">Кадр 02 — Цена</p>
        <h2>Пакеты и цены</h2>
        <p class="sec__sub">Три понятных пакета — сравните без конфигуратора. Диапазон: от 15 000 до 50 000 ₽.</p>
        <div class="packs">
          <article class="pack">
            <h3>Мини</h3>
            <p class="pack__price">15 000 ₽</p>
            <p class="pack__meta">1 ч квест + 30 мин стол · до 8 детей</p>
            <ul class="pack__list">
              <li>Квест-шоу с командой ведущих-актёров</li>
              <li>Праздничный стол (еду приносите свою)</li>
              <li>Сувенир каждому ребёнку</li>
            </ul>
            <a href="#zayavka" class="btn btn--outline">Выбрать пакет</a>
          </article>
          <article class="pack pack--hot">
            <span class="pack__tag">Чаще всего выбирают</span>
            <h3>Популярный</h3>
            <p class="pack__price">24 000 ₽</p>
            <p class="pack__meta">1,5 ч квест + 30 мин игры + 30 мин стол · до 15 детей</p>
            <ul class="pack__list">
              <li>Квест-шоу 1,5 ч с командой из 3 ведущих-актёров</li>
              <li>Подвижные игры с призами — 30 мин</li>
              <li>Праздничный стол (еду приносите свою)</li>
            </ul>
            <a href="#zayavka" class="btn btn--cta">Выбрать пакет</a>
          </article>
          <article class="pack">
            <h3>Максимальный</h3>
            <p class="pack__price">50 000 ₽</p>
            <p class="pack__meta">1,5 ч квест + 1 ч ярмарка · до 15 детей</p>
            <ul class="pack__list">
              <li>Квест-шоу 1,5 ч + расширенная ярмарка игр 1 ч</li>
              <li>Меню под ключ, большой торт от кондитера</li>
              <li>Фотограф, гелиевые шары, подарок каждому</li>
            </ul>
            <a href="#zayavka" class="btn btn--outline">Выбрать пакет</a>
          </article>
        </div>
        <p class="packs__note">Свыше лимита — +1 000 ₽ за ребёнка. Есть ещё Базовый, Оптимальный и Расширенный — расскажем при брони.</p>
      </div>
    </section>

    <!-- 4. КАК ПРОХОДИТ ПРАЗДНИК -->
    <section class="sec sec--alt" id="program">
      <div class="wrap">
        <p class="frame">Кадр 03 — Программа</p>
        <h2>Как проходит праздник</h2>
        <div class="prog">
          <ol class="prog__list">
            <li><b>Сборы и инструктаж</b><span>Дети знакомятся с ведущими, надевают игровые футболки.</span></li>
            <li><b>Квест-шоу</b><span>Испытания на логику, скорость и командную работу.</span></li>
            <li><b>Сувенир каждому</b><span>Памятный подарок всем участникам.</span></li>
            <li><b>Поздравление и торт</b><span>Свечи, именинник в центре — самые живые кадры.</span></li>
            <li><b>Банкет</b><span>Сервированный стол: своя еда или под ключ.</span></li>
            <li><b>Ярмарка игр</b><span>Ведущие одновременно ведут разные активности.</span></li>
            <li><b>Чай с тортом и сборы</b><span>Спокойный финал праздника.</span></li>
          </ol>
          <figure class="prog__media">
            <img src="/photos/squid-game-quest-33.webp" alt="Дети собирают деревянный пазл на полу во время игры" loading="lazy" />
          </figure>
        </div>
      </div>
    </section>

    <!-- 5. ПОЧЕМУ ДОРОЖЕ КВЕСТА -->
    <section class="sec" id="why">
      <div class="wrap why">
        <figure class="why__media">
          <img src="/photos/squid-game-quest-17.webp" alt="Дети в игровых футболках с номерами на площадке" loading="lazy" />
        </figure>
        <div class="why__text">
          <p class="frame">Кадр 04 — Честно о цене</p>
          <h2>Почему дороже обычного квеста</h2>
          <p>В обычном квесте ребёнка встречают оператор и один актёр. У нас на празднике работает команда из 3 ведущих-актёров плюс организатор — каждый занят делом: ведут игру, накрывают стол, следят за порядком.</p>
          <p>Это формат «под ключ»: сценарий, актёры, стол, торт и фото — а не час в закрытой комнате.</p>
          <a href="#zayavka" class="btn btn--cta">Оставить заявку</a>
        </div>
      </div>
    </section>

    <!-- 6. ПЛОЩАДКА И АДРЕС -->
    <section class="sec sec--alt" id="venue">
      <div class="wrap">
        <p class="frame">Кадр 05 — Площадка</p>
        <h2>Площадка и адрес</h2>
        <div class="venue">
          <figure class="venue__media">
            <img src="/photos/banquet-room-1.webp" alt="Сервированный банкетный стол с яркой посудой" loading="lazy" />
          </figure>
          <div class="venue__text">
            <p class="venue__addr">Ростов-на-Дону, ул. Зорге, 15</p>
            <ul class="venue__list">
              <li>Отдельный вход с торца здания</li>
              <li>Игровая и банкетные комнаты под одной крышей</li>
              <li>Родителям есть где сесть — смотрите игру или отдыхайте</li>
              <li>Вентиляция и кондиционеры, холодильник и микроволновка</li>
            </ul>
            <a href={MAPS} target="_blank" rel="noopener" class="btn btn--outline">Как добраться</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. ОТЗЫВЫ -->
    <section class="sec" id="reviews">
      <div class="wrap">
        <p class="frame">Кадр 06 — Отзывы</p>
        <h2>Отзывы</h2>
        <p class="sec__sub">Реальные отзывы с Яндекс.Карт. <a href={REVIEWS} target="_blank" rel="noopener">Читать все отзывы</a></p>
        <div class="revs">
          <blockquote class="rev">
            <p>«Дети не хотели уходить, всё время прохождения держали в напряжении, но не пугали, а именно увлекали!»</p>
            <cite>Таня К. · Яндекс.Карты</cite>
          </blockquote>
          <blockquote class="rev">
            <p>«Сделали под ключ, дети были довольны, родители избавлены от лишней суеты в организации.»</p>
            <cite>Екатерина Щ. · Яндекс.Карты</cite>
          </blockquote>
          <blockquote class="rev">
            <p>«Все дети задействованы в игру. Активный, динамичный квест. Не страшно.»</p>
            <cite>Михаил К. · Яндекс.Карты</cite>
          </blockquote>
          <blockquote class="rev">
            <p>«Именинница была в приоритете, это важно. Всё продумано до мелочей.»</p>
            <cite>Родитель · Яндекс.Карты</cite>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- 8. FAQ -->
    <section class="sec sec--alt" id="faq">
      <div class="wrap wrap--narrow">
        <p class="frame">Кадр 07 — Вопросы</p>
        <h2>Частые вопросы</h2>
        <div class="faq">
          <details><summary>Это же «Игра в кальмара» — это страшно?</summary><p>Нет. От сериала мы взяли только игры и реквизит — всё адаптировано под детей. Это не хоррор, а увлекательное квест-шоу с актёрами, где в центре внимания именинник.</p></details>
          <details><summary>Почему у вас дороже обычных квестов?</summary><p>В обычном квесте — оператор и один актёр. У нас работает команда из 3 ведущих-актёров плюс организатор, и каждый занят делом. Это формат «под ключ», а не час в закрытой комнате.</p></details>
          <details><summary>С какого возраста?</summary><p>Специализация — 6–12 лет, сценарий адаптируется: младшим играем мягче, старшим добавляем логику и командные задания. Младших (от 4 лет) берём вместе с братом или сестрой.</p></details>
          <details><summary>Что с собой везти?</summary><p>Зависит от пакета. В «Мини» и «Популярном» еду приносите свою — стол накрываем мы. В «Максимальном» меню под ключ и большой торт от кондитера включены.</p></details>
          <details><summary>Как забронировать и сколько ждать?</summary><p>Оставьте заявку или позвоните — организатор перезвонит в течение часа. Предоплата 3 000 ₽, возвращается в любой день, кроме дня праздника.</p></details>
        </div>
      </div>
    </section>

    <!-- 9. ФОРМА ЗАЯВКИ + АЛЬТЕРНАТИВЫ -->
    <section class="sec sec--form" id="zayavka">
      <div class="wrap form-wrap">
        <div class="form-intro">
          <p class="frame">Кадр 08 — Заявка</p>
          <h2>Оставить заявку</h2>
          <p>Оставьте контакты — организатор перезвонит в течение часа, подберёт пакет и ответит на вопросы. Без давления.</p>
          <div class="alts">
            <a href={`tel:${TEL}`} class="alt">Позвонить<br /><b>{TEL_VIEW}</b></a>
            <a href={WA} target="_blank" rel="noopener" class="alt">WhatsApp</a>
            <a href={TG} target="_blank" rel="noopener" class="alt">Telegram</a>
            <a href={MAX} target="_blank" rel="noopener" class="alt">МАКС</a>
          </div>
        </div>
        <form class="form" onsubmit="return false">
          <label class="field"><span>Имя</span><input type="text" name="name" placeholder="Как вас зовут" autocomplete="name" /></label>
          <label class="field"><span>Телефон</span><input type="tel" name="phone" placeholder="+7 (___) ___-__-__" autocomplete="tel" /></label>
          <label class="field"><span>Дата праздника</span><input type="date" name="date" /></label>
          <label class="field"><span>Пакет</span>
            <select name="pack">
              <option>Ещё не выбрал(а)</option>
              <option>Мини — 15 000 ₽</option>
              <option>Популярный — 24 000 ₽</option>
              <option>Максимальный — 50 000 ₽</option>
            </select>
          </label>
          <label class="check"><input type="checkbox" name="consent" /> <span>Согласен(а) на обработку персональных данных для связи по заявке</span></label>
          <button type="submit" class="btn btn--cta btn--lg btn--block">Отправить заявку</button>
        </form>
      </div>
    </section>

    <!-- 10. КАЛЬКУЛЯТОР (демотирован) -->
    <section class="sec sec--calc" id="calc">
      <div class="wrap calc">
        <div>
          <h3>Хотите точную смету?</h3>
          <p>Соберите праздник по позициям — ярмарка, фотограф, шары, торт. Расчёт предварительный, точную сумму подтвердит организатор.</p>
        </div>
        <a href="#zayavka" class="btn btn--outline">Рассчитать точно</a>
      </div>
    </section>
  </main>

  <footer class="ftr">
    <div class="wrap ftr__in">
      <div>
        <a href="#top" class="logo">XKALMAR</a>
        <p class="ftr__about">Квест-шоу «Игра в кальмара» для детей 6–12 лет. Праздник под ключ в Ростове-на-Дону, ул. Зорге, 15.</p>
      </div>
      <nav class="ftr__col" aria-label="Связь">
        <b>Связаться</b>
        <a href={`tel:${TEL}`}>{TEL_VIEW}</a>
        <a href={MAX} target="_blank" rel="noopener">МАКС</a>
        <a href={TG} target="_blank" rel="noopener">Telegram</a>
        <a href={WA} target="_blank" rel="noopener">WhatsApp</a>
      </nav>
      <nav class="ftr__col" aria-label="Инфо">
        <b>Инфо</b>
        <a href="/privacy" target="_blank" rel="noopener">Политика конфиденциальности</a>
      </nav>
    </div>
    <div class="wrap ftr__bottom">© 2026 XKALMAR · Услугу оказывает ИП Терентьев С.В. (ИНН 110556190456)</div>
  </footer>

  <a href="#zayavka" class="sticky-cta">Оставить заявку</a>
</Concept>

<style is:global>
  :root {
    --bg: #0A0A0E;
    --bg-alt: #101016;
    --surface: #16161E;
    --surface-2: #1E1E28;
    --text: #F4F1EC;
    --text-2: rgba(244, 241, 236, .66);
    --text-3: rgba(244, 241, 236, .42);
    --accent: #0AD9C6;
    --cta: #FF2D6B;
    --cta-hover: #FF4D82;
    --on-cta: #FFFFFF;
    --line: rgba(255, 255, 255, .12);
    --star: #F5A623;
    --wrap: 1160px;
    --r: 4px;
    --r-l: 8px;
  }
  body { background: var(--bg); color: var(--text); }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 24px; width: 100%; }
  .wrap--narrow { max-width: 820px; }
  [id] { scroll-margin-top: 84px; }

  /* Кнопки */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 12px 22px; border-radius: var(--r); border: 1px solid transparent;
    font-weight: 700; font-size: 15px; text-decoration: none; cursor: pointer;
    transition: background .15s ease, color .15s ease, border-color .15s ease, transform .15s ease;
  }
  .btn--cta { background: var(--cta); color: var(--on-cta); }
  .btn--cta:hover { background: var(--cta-hover); }
  .btn--cta:active { transform: scale(.98); }
  .btn--outline { border-color: var(--line); color: var(--text); background: transparent; }
  .btn--outline:hover { border-color: var(--accent); color: var(--accent); }
  .btn--ghost { color: var(--text-2); border-color: var(--line); }
  .btn--ghost:hover { color: var(--text); border-color: var(--text-2); }
  .btn--lg { padding: 16px 30px; font-size: 16px; }
  .btn--block { width: 100%; }

  /* Шапка */
  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(10,10,14,.86); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 24px; }
  .logo { font-weight: 900; font-size: 22px; letter-spacing: .12em; text-decoration: none; color: var(--text); }
  .hdr__nav { display: flex; gap: 22px; }
  .hdr__nav a { color: var(--text-2); text-decoration: none; font-size: 14px; font-weight: 600; }
  .hdr__nav a:hover { color: var(--text); }
  .hdr__right { display: flex; align-items: center; gap: 16px; }
  .hdr__phone { color: var(--text-2); text-decoration: none; font-size: 14px; }
  .hdr__phone:hover { color: var(--text); }
  .hdr__cta { padding: 10px 18px; font-size: 14px; }

  /* Hero */
  .hero { position: relative; overflow: hidden; }
  .hero__media { position: absolute; inset: 0; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; }
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,10,14,.96) 0%, rgba(10,10,14,.82) 42%, rgba(10,10,14,.35) 100%), linear-gradient(0deg, rgba(10,10,14,.9), rgba(10,10,14,0) 55%); }
  .hero__in { position: relative; padding: 96px 24px 72px; max-width: var(--wrap); }
  .kicker { font-size: 12px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--accent); margin-bottom: 20px; }
